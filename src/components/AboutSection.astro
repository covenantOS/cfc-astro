---
interface Props {
  eyebrow?: string;
  heading?: string;
  body?: string;
  pills?: string[];
  image?: string;
  imageAlt?: string;
  imageBadge?: { title: string; subtitle?: string };
  cta?: { label: string; href: string };
}

const {
  eyebrow = 'Our Story',
  heading = 'Over 25 Years of Bespoke Interior Design',
  body = 'We opened our doors in 2000 with a clear mission to provide St. Petersburg homeowners with uncompromising quality in <a href="/window-treatments-st-petersburg/">custom window treatments</a> and <a href="/services/furniture-reupholstery/">upholstery</a>. Operating from our dedicated local workroom in <a href="/areas/west-st-pete/">West St. Pete</a>, we bypass mass production to focus entirely on precision tailoring. By bringing our curated designer showroom directly to your living space, we ensure every fabric selection perfectly complements your natural lighting and exact architectural style.',
  pills = ['25+ Years Exp.', 'Local Workroom', 'Fully Insured'],
  image = '/images/services/custom-bedding-pillows/hero.webp',
  imageAlt = 'Custom bedding, pillows, and drapery designed and installed by Custom Fabric Creations in a St. Petersburg, FL home',
  imageBadge = { title: 'Established 2000', subtitle: 'Serving the St. Pete coast' },
  cta = { label: 'Learn More About Us', href: '/about/' },
} = Astro.props;
---

<section class="py-20 md:py-28 bg-cream-50">
  <div class="container-site grid gap-12 md:grid-cols-2 items-center">
    <div class="relative pb-10 md:pb-0">
      <div class="aspect-[4/5] overflow-hidden rounded-lg">
        <img
          src={image}
          alt={imageAlt}
          title={imageAlt}
          class="w-full h-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
      {imageBadge && (
        <div class="absolute -bottom-3 -left-3 md:-bottom-6 md:-left-6 bg-brand-700 text-white px-6 py-5 max-w-[240px] rounded-sm shadow-soft border border-brand-800/40">
          <p class="font-display text-xl md:text-2xl text-white leading-tight">{imageBadge.title}</p>
          {imageBadge.subtitle && <p class="text-[0.7rem] text-white/80 mt-1.5 uppercase tracking-[0.2em] font-semibold">{imageBadge.subtitle}</p>}
        </div>
      )}
    </div>

    <div>
      {eyebrow && <p class="eyebrow" style="letter-spacing: 0.3em;">{eyebrow}</p>}
      <h2 class="font-display text-4xl md:text-5xl text-ink-800 leading-tight mb-6">{heading}</h2>
      <div class="mb-8 space-y-4">
        {body.split('\n\n').map((para) => (
          <p class="text-ink-500 leading-relaxed text-lg [&_a]:text-brand-600 [&_a:hover]:text-brand-500 [&_a]:underline [&_a]:underline-offset-2" set:html={para} />
        ))}
      </div>

      <div class="flex flex-wrap gap-3 mb-8">
        {pills.map((p) => (
          <span class="inline-flex items-center px-5 py-2 bg-brand-50 border border-brand-200 text-brand-700 text-sm font-semibold rounded-sm">
            {p}
          </span>
        ))}
      </div>

      {cta && <a href={cta.href} class="btn-primary">{cta.label}</a>}
    </div>
  </div>
</section>
