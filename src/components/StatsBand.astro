---
// "By the numbers" strip. Verified-source stats only.
//
// Every external statistic must include a sourceUrl pointing to a primary
// or authoritative secondary source (NOAA, US Census, DOE, ENERGY STAR,
// peer-reviewed studies, established industry orgs). Internal stats (CFC
// years, projects, etc.) use the `internal: true` flag and skip the URL.
//
// The sourceUrl is rendered as a small footnote underneath each stat so
// readers and Daniel can audit the claim at any time. This is the contract
// that prevents the "by the numbers" section from drifting into invented
// marketing numbers over time.
//
// Usage:
//   <StatsBand
//     eyebrow="By the numbers"
//     heading="Why plantation shutters work in Florida"
//     stats={[
//       { value: '361', unit: 'days', label: 'of sunshine per year in St. Petersburg', sourceUrl: 'https://www.weather.gov/...', sourceLabel: 'NOAA' },
//       { value: '25+', unit: 'years', label: 'installing in Pinellas County', internal: true },
//     ]}
//   />

interface Stat {
  value: string;
  unit?: string;
  label: string;
  sourceUrl?: string;
  sourceLabel?: string;
  internal?: boolean;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  stats: Stat[];
  variant?: 'light' | 'dark';
}

const {
  eyebrow = 'By the numbers',
  heading,
  subheading,
  stats,
  variant = 'light',
} = Astro.props;

const isDark = variant === 'dark';
---

<section class={`my-12 md:my-14 not-prose ${isDark ? 'bg-ink-900 text-white' : 'bg-cream-50'} rounded-lg overflow-hidden shadow-card`}>
  <div class="h-1 bg-brand-500"></div>
  <div class="p-7 md:p-10">

    {(eyebrow || heading || subheading) && (
      <div class="text-center max-w-2xl mx-auto mb-8">
        {eyebrow && (
          <p
            class={`eyebrow mb-2 ${isDark ? 'text-brand-400' : 'text-brand-700'}`}
            style="letter-spacing: 0.25em;"
          >{eyebrow}</p>
        )}
        {heading && (
          <h3 class={`font-display text-2xl md:text-3xl leading-tight mb-2 ${isDark ? 'text-white' : 'text-ink-800'}`}>{heading}</h3>
        )}
        {subheading && (
          <p class={`text-sm md:text-base ${isDark ? 'text-white/70' : 'text-ink-500'}`}>{subheading}</p>
        )}
      </div>
    )}

    <div class={`grid gap-6 md:gap-8 ${stats.length === 3 ? 'md:grid-cols-3' : stats.length === 4 ? 'md:grid-cols-2 lg:grid-cols-4' : 'md:grid-cols-2'}`}>
      {stats.map((s) => (
        <div class="text-center">
          <p class={`font-display text-4xl md:text-5xl leading-none tabular-nums ${isDark ? 'text-brand-400' : 'text-brand-600'}`}>
            {s.value}{s.unit && <span class="text-2xl md:text-3xl ml-1">{s.unit}</span>}
          </p>
          <p class={`mt-3 text-sm md:text-base leading-snug ${isDark ? 'text-white/80' : 'text-ink-700'}`}>{s.label}</p>
          {s.sourceUrl ? (
            <p class="mt-2 text-[0.7rem] uppercase tracking-wider opacity-60">
              <a
                href={s.sourceUrl}
                target="_blank"
                rel="noopener nofollow"
                class={`underline decoration-dotted underline-offset-2 ${isDark ? 'text-white/70 hover:text-white' : 'text-ink-500 hover:text-ink-700'}`}
              >Source: {s.sourceLabel ?? 'cited'}</a>
            </p>
          ) : s.internal ? (
            <p class={`mt-2 text-[0.7rem] uppercase tracking-wider opacity-60 ${isDark ? 'text-white/60' : 'text-ink-400'}`}>Our records</p>
          ) : null}
        </div>
      ))}
    </div>
  </div>
</section>
