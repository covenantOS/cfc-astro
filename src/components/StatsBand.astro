---
// "By the numbers" stats grid. Cream surface, gold accent rule, tightened
// hierarchy so the heading sits with the eyebrow, then the stats sit in
// a row with subtle vertical dividers between them.
//
// Every external statistic must include `sourceUrl` (rendered as a small
// dotted-underline citation). Internal stats set `internal: true` and
// render "Our records" instead. This is a hard rule: see project-cfc-decisions.

interface Stat {
  value: string;
  unit?: string;
  label: string;
  sourceUrl?: string;
  sourceLabel?: string;
  internal?: boolean;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  stats: Stat[];
}

const {
  eyebrow = 'By the numbers',
  heading,
  subheading,
  stats,
} = Astro.props;

const gridCols = stats.length === 4
  ? 'sm:grid-cols-2 lg:grid-cols-4'
  : stats.length === 3
  ? 'sm:grid-cols-3'
  : stats.length === 2
  ? 'sm:grid-cols-2'
  : 'grid-cols-1';
---

<section class="my-10 md:my-12 not-prose">
  <div
    class="rounded-lg shadow-card overflow-hidden"
    style="background-color: var(--color-cream-50);"
  >
    <div class="h-1" style="background-color: var(--color-brand-500);"></div>
    <div class="p-5 md:p-6">

      {(eyebrow || heading || subheading) && (
        <div class="text-center max-w-2xl mx-auto mb-5">
          {eyebrow && (
            <p
              class="font-display text-[0.7rem] uppercase mb-1.5"
              style="letter-spacing: 0.22em; color: var(--color-brand-700);"
            >{eyebrow}</p>
          )}
          {heading && (
            <h3 class="font-display text-base md:text-lg leading-snug" style="color: var(--color-ink-800);">{heading}</h3>
          )}
          {subheading && (
            <p class="text-sm mt-1.5" style="color: var(--color-ink-500);">{subheading}</p>
          )}
        </div>
      )}

      <div class={`grid gap-5 ${gridCols} sm:divide-x sm:divide-brand-500/20`}>
        {stats.map((s) => (
          <div class="text-center px-2 md:px-4">
            <p class="font-display leading-none tabular-nums" style="color: var(--color-brand-700);">
              <span class="text-xl md:text-2xl font-bold">{s.value}</span>
              {s.unit && (
                <span class="text-sm md:text-base ml-1" style="color: var(--color-brand-600);">{s.unit}</span>
              )}
            </p>
            <p class="mt-2 text-[0.8rem] leading-snug" style="color: var(--color-ink-700);">{s.label}</p>
            {s.sourceUrl ? (
              <p class="mt-1.5 text-[0.6rem] uppercase tracking-wider">
                <a
                  href={s.sourceUrl}
                  target="_blank"
                  rel="noopener nofollow"
                  class="decoration-dotted underline-offset-2"
                  style="color: var(--color-ink-400); text-decoration: underline; text-decoration-style: dotted;"
                >Source: {s.sourceLabel ?? 'cited'}</a>
              </p>
            ) : s.internal ? (
              <p class="mt-1.5 text-[0.6rem] uppercase tracking-wider" style="color: var(--color-ink-300);">Our records</p>
            ) : null}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
