---
// "By the numbers" one-liner banner. Warm brown (coffee-500) bg, gold
// uppercase eyebrow, single bold one-sentence stat summary.
//
// Use for end-of-section closers where a single distilled claim hits
// harder than a grid. Daniel's directive: stats must be verified. Keep
// external/sourced numbers in the body copy with an inline citation;
// this banner is for internal headline facts (years, brands, scope).

interface Props {
  eyebrow?: string;
  statement: string;
}

const {
  eyebrow = 'By the numbers',
  statement,
} = Astro.props;
---

<aside class="my-12 md:my-14 not-prose">
  <div class="bg-coffee-500 text-white rounded-lg shadow-card overflow-hidden">
    <div class="p-6 md:p-8">
      <p class="font-display text-xs uppercase mb-3" style="letter-spacing: 0.25em; color: #f3efe4;">{eyebrow}</p>
      <p class="font-display text-xl md:text-2xl leading-snug" style="color: #ffffff;">{statement}</p>
    </div>
  </div>
</aside>
