---
import { SITE } from '~/lib/site';

interface Props {
  heading?: string;
  subtitle?: string;
  areaLabel?: string;
  phone?: string;
  phoneHref?: string;
}

const {
  heading = 'Start Your Custom Design Project',
  subtitle = 'Our studio crafts premium window treatments and custom upholstery for homes across the St. Pete coast. From the initial design consultation to flawless installation, we bring the showroom directly to you.',
  areaLabel = 'Serving all of the St. Pete coast',
  phone = SITE.phone,
  phoneHref = SITE.phoneHref,
} = Astro.props;
---

<!-- Luxurious white contact band.
     Previous design was dark/ink-900 which read as heavy on service pages;
     the refreshed block uses a soft ivory field with gold accents for a
     lighter, higher-end feel that still frames the CTA. -->
<section class="py-20 md:py-24 bg-white text-ink-800 relative">
  <div class="absolute inset-x-0 top-0 h-[3px] bg-brand-500"></div>

  <div class="container-site text-center max-w-2xl mx-auto mb-10">
    <p class="eyebrow mb-3" style="letter-spacing: 0.3em;">Start Your Project</p>
    <h2 class="font-display text-3xl md:text-4xl text-ink-900 mb-5 leading-tight">{heading}</h2>
    <p class="text-ink-500 leading-relaxed mb-8">{subtitle}</p>
    <div class="cta-group">
      <a href={phoneHref} class="btn-primary">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
        </svg>
        {phone}
      </a>
      <a href="/contact/" class="btn-ghost">Schedule Consultation</a>
    </div>
  </div>

  <div class="container-site">
    <div class="aspect-[16/8] max-w-5xl mx-auto overflow-hidden rounded-lg shadow-soft border border-brand-500/30">
      <iframe
        src="https://maps.google.com/maps?ll=27.80,-82.755&z=11&t=m&output=embed"
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Custom Fabric Creations service area, Tierra Verde to Largo, Pinellas County, FL">
      </iframe>
    </div>

    <div class="mt-8 flex items-center justify-center gap-6 text-sm text-ink-600">
      <span class="inline-flex items-center gap-2">
        <svg class="w-4 h-4 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        {areaLabel}
      </span>
      <a href={phoneHref} class="text-brand-700 font-semibold hover:text-brand-600">{phone}</a>
    </div>
  </div>
</section>
