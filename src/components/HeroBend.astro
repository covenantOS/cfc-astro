---
// Circular arc transition from the dark hero to the next (lighter) section.
// Uses a single elliptical arc so the bend reads as a clean, symmetric circle.
interface Props {
  nextBg?: string;
}
const { nextBg = '#ffffff' } = Astro.props;
---

<div class="relative w-full block" style="line-height:0;" aria-hidden="true">
  <svg
    viewBox="0 0 1440 120"
    preserveAspectRatio="none"
    class="block w-full h-20 md:h-28 lg:h-32"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- circular bend: edges low at 120, middle rises smoothly to 0 (next-bg rises into dark) -->
    <path
      d="M0,120 A 1800 1800 0 0 1 1440 120 L1440,120 L0,120 Z"
      fill={nextBg}
    />
    <!-- gold accent stroke tracing the circular arc -->
    <path
      d="M0,120 A 1800 1800 0 0 1 1440 120"
      fill="none"
      stroke="#bca050"
      stroke-width="4"
      vector-effect="non-scaling-stroke"
    />
  </svg>
</div>
