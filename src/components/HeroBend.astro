---
// Circular-downward divider between the hero and the next (lighter) section.
//
// Default: SVG paints a solid hero color above the curve and nextBg below.
// cutout: skip the solid fill so a hero video behind this strip shows through
// the smile. Only the white (or nextBg) lobe and the gold stroke are painted.
interface Props {
  nextBg?: string;
  heroColor?: string;
  cutout?: boolean;
}
const { nextBg = '#ffffff', heroColor = '#1a1a1a', cutout = false } = Astro.props;
---

<div
  class="relative w-full block"
  style={`line-height:0; background-color:${cutout ? 'transparent' : heroColor};`}
  aria-hidden="true"
>
  <svg
    viewBox="0 0 1440 120"
    preserveAspectRatio="none"
    class="block w-full h-20 md:h-28 lg:h-32"
    xmlns="http://www.w3.org/2000/svg"
  >
    {!cutout && (
      <path
        d="M0,0 L1440,0 Q720,160 0,0 Z"
        fill={heroColor}
      />
    )}
    <path
      d="M0,0 Q720,160 1440,0 L1440,120 L0,120 Z"
      fill={nextBg}
    />
    <path
      d="M0,0 Q720,160 1440,0"
      fill="none"
      stroke="#bca050"
      stroke-width="4"
      vector-effect="non-scaling-stroke"
    />
  </svg>
</div>
