---
// Concave arc transition from the dark hero to the next (lighter) section.
// Uses a cubic Bezier for a strong visible curve + gold stroke overlay.
interface Props {
  nextBg?: string;
}
const { nextBg = '#ffffff' } = Astro.props;
---

<div class="relative w-full block" style="line-height:0;" aria-hidden="true">
  <svg
    viewBox="0 0 1440 120"
    preserveAspectRatio="none"
    class="block w-full h-20 md:h-28 lg:h-32"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- concave curve: top edges are high, middle dips low -->
    <path
      d="M0,0 C360,20 540,120 720,120 C900,120 1080,20 1440,0 L1440,120 L0,120 Z"
      fill={nextBg}
    />
    <!-- gold accent stroke tracing the curve -->
    <path
      d="M0,0 C360,20 540,120 720,120 C900,120 1080,20 1440,0"
      fill="none"
      stroke="#bca050"
      stroke-width="4"
      vector-effect="non-scaling-stroke"
    />
  </svg>
</div>
