---
// Circular-downward bend between the dark hero and the next (lighter) section.
// The dark hero dips DOWN in the middle into the lighter section — a scoop shape.
interface Props {
  nextBg?: string;
}
const { nextBg = '#ffffff' } = Astro.props;
---

<div class="relative w-full block" style="line-height:0;" aria-hidden="true">
  <svg
    viewBox="0 0 1440 120"
    preserveAspectRatio="none"
    class="block w-full h-20 md:h-28 lg:h-32"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- scoop: edges at y=0 (dark hero ends at top), middle dips to y=120.
         next-bg fills BELOW the curve, so the dark hero visibly curves
         downward into the lighter section (a circular "smile" / scoop). -->
    <path
      d="M0,0 Q720,180 1440,0 L1440,120 L0,120 Z"
      fill={nextBg}
    />
    <!-- gold accent stroke tracing the scoop -->
    <path
      d="M0,0 Q720,180 1440,0"
      fill="none"
      stroke="#bca050"
      stroke-width="4"
      vector-effect="non-scaling-stroke"
    />
  </svg>
</div>
