---
// Concave arc transition from the dark hero to the next (lighter) section.
// Uses a cubic Bezier for a strong visible curve + gold stroke overlay.
interface Props {
  nextBg?: string;
}
const { nextBg = '#ffffff' } = Astro.props;
---

<div class="relative w-full block" style="line-height:0;" aria-hidden="true">
  <svg
    viewBox="0 0 1440 120"
    preserveAspectRatio="none"
    class="block w-full h-20 md:h-28 lg:h-32"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- convex curve: edges low, middle arcs up (white rises into dark) -->
    <path
      d="M0,120 C360,100 540,0 720,0 C900,0 1080,100 1440,120 Z"
      fill={nextBg}
    />
    <!-- gold accent stroke tracing the curve -->
    <path
      d="M0,120 C360,100 540,0 720,0 C900,0 1080,100 1440,120"
      fill="none"
      stroke="#bca050"
      stroke-width="4"
      vector-effect="non-scaling-stroke"
    />
  </svg>
</div>
