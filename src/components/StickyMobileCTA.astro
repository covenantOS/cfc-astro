---
import { getLocationForPath } from '~/lib/site';
const location = getLocationForPath(Astro.url.pathname);
---

<div
  id="sticky-mobile-cta"
  class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white shadow-[0_-4px_16px_rgba(0,0,0,0.10)] translate-y-full transition-transform duration-300"
>
  <div class="grid grid-cols-2">
    <a
      href={location.phoneHref}
      class="flex items-center justify-center gap-2.5 py-4 text-ink-800 font-bold border-r border-ink-100"
    >
      <span class="icon-badge-sm">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
        </svg>
      </span>
      <span class="text-sm">Call</span>
    </a>
    <a
      href="/contact/"
      class="flex items-center justify-center py-4 bg-brand-500 hover:bg-brand-600 text-white font-semibold text-sm uppercase tracking-wide transition"
      style="letter-spacing: 0.08em;"
    >
      Get Quote
    </a>
  </div>
</div>
<script>
  // Show the sticky call/quote bar only after the user scrolls past the
  // hero (and its in-hero Call + Schedule buttons). We reveal it once the
  // user has scrolled roughly one viewport down, and hide it again at the
  // very top. Slides up/down via the translate-y utility on the bar.
  const bar = document.getElementById('sticky-mobile-cta');
  if (bar) {
    const REVEAL_AT = () => Math.min(window.innerHeight * 0.85, 640);
    let shown = false;
    const update = () => {
      const past = window.scrollY > REVEAL_AT();
      if (past === shown) return;
      shown = past;
      bar.classList.toggle('translate-y-full', !shown);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }
</script>
