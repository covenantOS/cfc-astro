---
// Full section-based landing page for the two main areas (St. Petersburg
// Central and West St. Pete). Section stack:
// hero, intro, homeowner-needs cards, area window challenges, services grid,
// popular treatments, how-it-works, neighborhoods, why-choose-us, reviews,
// FAQ, contact/map.
// OwnerTip and ByNumbersBanner are intentionally NOT used here: those belong
// to long-form content+sidebar pages, not section-based landing pages.

import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import ServiceGrid from '~/components/ServiceGrid.astro';
import ReviewSection from '~/components/ReviewSection.astro';
import FAQ from '~/components/FAQ.astro';
import GlobalContactMap from '~/components/GlobalContactMap.astro';
import { getLocationForArea } from '~/lib/site';
import type { AreaPageConfig } from '~/data/area-pages';

interface Props {
  config: AreaPageConfig;
}

const { config } = Astro.props;
const location = getLocationForArea(config.slug);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Areas', url: '/areas/' },
  { name: config.name, url: `/areas/${config.slug}/` },
];

const seoTitle = `${config.name} Window Treatments, Shutters & Drapery | Custom Fabric Creations`;
const seoDescription = config.heroSubtitle;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  pageType="area"
  breadcrumbs={breadcrumbs}
  areaSlug={config.slug}
  areaTitle={config.name}
  faqs={config.faqs}
  ogImage={config.heroImage}
>
  <Hero
    title={config.heroTitle}
    subtitle={config.heroSubtitle}
    image={config.heroImage}
    primaryCta={{ label: location.phone, href: location.phoneHref }}
    secondaryCta={{ label: 'Schedule Consultation', href: '/contact/' }}
    breadcrumbs={breadcrumbs}
    goldLine
  />

  <!-- Intro / why this location -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container-site grid gap-10 lg:grid-cols-2 lg:gap-16 items-center max-w-6xl mx-auto">
      <div>
        <p class="eyebrow" style="letter-spacing: 0.3em;">{config.introEyebrow}</p>
        <h2 class="font-display text-3xl md:text-4xl text-ink-800 leading-tight mb-6">{config.introHeading}</h2>
        {config.introParagraphs.map((p) => (
          <p class="text-ink-600 leading-relaxed mb-4 text-[1.05rem]">{p}</p>
        ))}
        <a href={location.phoneHref} class="btn-primary mt-4 inline-flex">Call {location.phone}</a>
      </div>
      <div class="aspect-[4/3] overflow-hidden rounded-lg shadow-card">
        <img
          src={config.introImage}
          alt={`Custom window treatments and upholstery in ${config.name}, FL by Custom Fabric Creations`}
          class="w-full h-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- What homeowners need (cards) -->
  <section class="py-16 md:py-20 bg-cream-50">
    <div class="container-site max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <p class="eyebrow" style="letter-spacing: 0.3em;">Built for {config.name}</p>
        <h2 class="font-display text-3xl md:text-4xl text-ink-800 leading-tight mb-4">{config.needsHeading}</h2>
        <p class="text-ink-600 leading-relaxed">{config.needsIntro}</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {config.needs.map((c) => (
          <div class="bg-white border border-coffee-200/70 rounded-lg shadow-card p-6 md:p-7">
            <div class="flex items-start gap-3">
              <span class="mt-1 w-8 h-8 rounded-full bg-brand-500/15 text-brand-600 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              <div>
                <h3 class="font-display text-lg md:text-xl text-ink-800 mb-1.5">{c.title}</h3>
                <p class="text-ink-600 text-sm md:text-[0.95rem] leading-relaxed">{c.body}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Window challenges specific to the area (long-form) -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container-site grid gap-10 lg:grid-cols-2 lg:gap-16 items-start max-w-6xl mx-auto">
      <div>
        <p class="eyebrow" style="letter-spacing: 0.3em;">Local Expertise</p>
        <h2 class="font-display text-3xl md:text-4xl text-ink-800 leading-tight mb-6">{config.challengesHeading}</h2>
        {config.challengesParagraphs.map((p) => (
          <p class="text-ink-600 leading-relaxed mb-4 text-[1.05rem]">{p}</p>
        ))}
      </div>
      <div class="bg-cream-50 border border-coffee-200/70 rounded-lg p-7 md:p-8 lg:mt-2">
        <p class="font-display text-sm uppercase tracking-[0.2em] text-brand-700 mb-5">What we design around here</p>
        <ul class="space-y-3">
          {config.challengesList.map((item) => (
            <li class="flex items-start gap-3 text-ink-700">
              <svg class="w-5 h-5 text-brand-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
              <span class="leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Services available here -->
  <ServiceGrid
    eyebrow="What we offer"
    heading={config.servicesHeading}
    subtitle={`Every service below is available in ${config.name}, measured, built, and installed by our own team.`}
    limit={6}
  />

  <!-- Popular treatments (links into service pages) -->
  <section class="py-16 md:py-20 bg-cream-50">
    <div class="container-site max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <p class="eyebrow" style="letter-spacing: 0.3em;">Most Requested</p>
        <h2 class="font-display text-3xl md:text-4xl text-ink-800 leading-tight mb-4">{config.treatmentsHeading}</h2>
        <p class="text-ink-600 leading-relaxed">{config.treatmentsIntro}</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {config.treatments.map((t) => (
          <a href={t.href} class="group bg-white border border-coffee-200/70 rounded-lg shadow-card p-6 md:p-7 transition hover:shadow-card-hover hover:-translate-y-0.5 block">
            <h3 class="font-display text-lg md:text-xl text-ink-800 mb-1.5 group-hover:text-brand-700 transition">{t.title}</h3>
            <p class="text-ink-600 text-sm md:text-[0.95rem] leading-relaxed mb-3">{t.body}</p>
            <span class="text-brand-700 font-semibold text-sm inline-flex items-center gap-1">
              Learn more
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 10h10M11 5l5 5-5 5"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works (process) -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container-site max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <p class="eyebrow" style="letter-spacing: 0.3em;">The Process</p>
        <h2 class="font-display text-3xl md:text-4xl text-ink-800 leading-tight mb-4">{config.processHeading}</h2>
        <p class="text-ink-600 leading-relaxed">{config.processIntro}</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {config.process.map((step, i) => (
          <div class="bg-cream-50 border border-coffee-200/70 rounded-lg p-6">
            <span class="font-display text-3xl text-brand-500 leading-none">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-display text-lg text-ink-800 mt-3 mb-1.5">{step.title}</h3>
            <p class="text-ink-600 text-sm leading-relaxed">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Neighborhoods -->
  <section class="py-16 md:py-20 bg-cream-50">
    <div class="container-site max-w-4xl mx-auto text-center">
      <p class="eyebrow" style="letter-spacing: 0.3em;">Service Area</p>
      <h2 class="font-display text-3xl md:text-4xl text-ink-800 leading-tight mb-4">{config.neighborhoodsHeading}</h2>
      <p class="text-ink-600 leading-relaxed mb-8 max-w-2xl mx-auto">{config.neighborhoodsIntro}</p>
      <div class="flex flex-wrap justify-center gap-3">
        {config.neighborhoods.map((n) => (
          <span class="inline-flex items-center gap-2 bg-white border border-coffee-200/70 shadow-card rounded-full px-5 py-2.5 text-sm text-ink-700">
            <svg class="w-4 h-4 text-brand-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            {n.name}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Why choose CFC (trust points) -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container-site max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <p class="eyebrow" style="letter-spacing: 0.3em;">Why Choose Us</p>
        <h2 class="font-display text-3xl md:text-4xl text-ink-800 leading-tight">{config.whyHeading}</h2>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {config.why.map((c) => (
          <div class="bg-cream-50 border border-coffee-200/70 rounded-lg p-6">
            <h3 class="font-display text-lg text-ink-800 mb-1.5">{c.title}</h3>
            <p class="text-ink-600 text-sm leading-relaxed">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <ReviewSection />

  <!-- FAQ -->
  <FAQ
    items={config.faqs}
    heading={`${config.name}: Frequently Asked Questions`}
    eyebrow="Common Questions"
    subtitle={`Answers about our work in ${config.name}.`}
  />

  <!-- Contact + map -->
  <GlobalContactMap
    areaLabel={`Serving ${config.name} & the St. Pete coast`}
    phone={location.phone}
    phoneHref={location.phoneHref}
  />
</BaseLayout>
