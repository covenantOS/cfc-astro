---
// Contextual Google review embedded mid-content on a service or area page.
// Distinct from the page-level ReviewSection (which is a full carousel +
// stats bar). This is a lighter quote-block treatment, designed to break
// up long-form content with social proof relevant to that page's topic.
//
// You can pass an explicit review object, or use the `tag` prop to pull
// one automatically from the central reviews data layer by service tag.
//
// Usage A (explicit):
//   <InlineReview review={someReview} />
//
// Usage B (by tag, picks the first matching review from the data file):
//   <InlineReview tag="plantation-shutters" />
//
// If no matching review is found, the component renders nothing rather
// than show a placeholder.

import type { Review, ReviewTag } from '~/data/reviews';
import { getReviewsByTag } from '~/data/reviews';

interface Props {
  review?: Review;
  tag?: ReviewTag;
  // Optional surrounding label (e.g. "What St. Pete homeowners say")
  label?: string;
}

const { review: passedReview, tag, label } = Astro.props;

const review: Review | undefined =
  passedReview ?? (tag ? getReviewsByTag(tag, 1)[0] : undefined);
---

{review && (
  <aside class="my-10 md:my-12 not-prose">
    {label && (
      <p class="eyebrow mb-3 text-brand-700" style="letter-spacing: 0.25em;">{label}</p>
    )}
    <div class="bg-white border-l-4 border-brand-500 rounded-r-lg shadow-card p-6 md:p-7">
      <div class="flex items-center gap-2 mb-3">
        <div class="flex items-center gap-0.5 text-[#FBBC04]" aria-label={`${review.rating} out of 5 stars`}>
          {Array.from({ length: review.rating }).map(() => (
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>
        <svg class="w-4 h-4 shrink-0 ml-1" viewBox="0 0 48 48" aria-label="Google review">
          <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20c11 0 20-8 20-20 0-1.3-.1-2.3-.4-3.5z"/>
          <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.1 18.9 12 24 12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
          <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35 26.7 36 24 36c-5.2 0-9.7-3.3-11.3-8l-6.5 5C9.4 39.6 16.1 44 24 44z"/>
          <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.2 5.6l6.2 5.2C41.4 35.5 44 30.2 44 24c0-1.3-.1-2.3-.4-3.5z"/>
        </svg>
      </div>
      <blockquote class="text-ink-700 italic leading-relaxed mb-4">
        "{review.body}"
      </blockquote>
      <footer class="flex items-center gap-3 pt-3 border-t border-line">
        {review.avatar ? (
          <img
            src={review.avatar}
            alt=""
            class="w-9 h-9 rounded-full object-cover shrink-0"
            width="36"
            height="36"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div
            class="w-9 h-9 rounded-full flex items-center justify-center text-white font-bold text-xs shrink-0"
            style={`background-color: ${review.avatarColor};`}
            aria-hidden="true"
          >{review.initials}</div>
        )}
        <div>
          <p class="font-bold text-ink-800 text-sm leading-tight">{review.name}</p>
          <p class="text-ink-400 text-xs mt-0.5">{review.dateLabel} · Google</p>
        </div>
      </footer>
    </div>
  </aside>
)}
