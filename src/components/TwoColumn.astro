---
interface Props {
  eyebrow?: string;
  title: string;
  image?: string;
  imageAlt?: string;
  imagePosition?: 'left' | 'right';
  cta?: { label: string; href: string };
}

const {
  eyebrow,
  title,
  image,
  imageAlt = '',
  imagePosition = 'right',
  cta,
} = Astro.props;
---

<section class="py-20 md:py-28 bg-white">
  <div class="container-site grid gap-12 md:grid-cols-2 items-center">
    <div class:list={[imagePosition === 'right' ? 'md:order-1' : 'md:order-2']}>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl title-rule-left">{title}</h2>
      <div class="mt-6 prose-cfc">
        <slot />
      </div>
      {cta && (
        <div class="mt-8">
          <a href={cta.href} class="btn-ghost">{cta.label}</a>
        </div>
      )}
    </div>
    {image && (
      <div class:list={['aspect-[4/5] overflow-hidden rounded-sm', imagePosition === 'right' ? 'md:order-2' : 'md:order-1']}>
        <img src={image} alt={imageAlt} class="w-full h-full object-cover" loading="lazy" />
      </div>
    )}
  </div>
</section>
