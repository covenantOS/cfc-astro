---
// "How it works" in three simple steps. Reassures first-time buyers that
// the process is easy and low-pressure, and reinforces the in-house,
// no-subcontractor differentiator. Wording approved by client.
import { SITE } from '~/lib/site';

const steps = [
  {
    n: '1',
    title: 'Free In-Home Consultation',
    body: 'We bring the designer fabric library and samples to your living room, evenings and weekends included, anywhere across <a href="/areas/">Pinellas County</a>. You see everything in your actual light, with no showroom trip and no pressure. <a href="/contact/">Book a free consultation</a> whenever you are ready.',
    icon: 'calendar',
  },
  {
    n: '2',
    title: 'Custom Design & Measure',
    body: 'We measure every window precisely and tailor each piece to your space, lighting, and style. You choose from a curated shortlist, not an overwhelming wall of options.',
    icon: 'ruler',
  },
  {
    n: '3',
    title: 'White-Glove Installation',
    body: 'Our own team installs and finishes the job, never a subcontractor. We level, adjust, and confirm the fit, including <a href="/services/motorized-shades/">motorized shades</a> that need their travel limits set. See finished work in our <a href="/gallery/">project gallery</a>.',
    icon: 'check',
  },
];
---

<section class="py-20 md:py-28 bg-white">
  <div class="container-site">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <p class="eyebrow" style="letter-spacing: 0.3em;">How It Works</p>
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl text-ink-800 leading-tight mb-4">
        Three Easy Steps to a Finished Room
      </h2>
      <p class="text-ink-500 text-base md:text-lg">
        From the first call to the final install, we keep it simple and handle every detail in-house.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      {steps.map((s, i) => (
        <div class="relative text-center px-4">
          {i < steps.length - 1 && (
            <div class="hidden md:block absolute top-8 left-[60%] w-[80%] h-px bg-line" aria-hidden="true"></div>
          )}
          <div class="relative inline-flex items-center justify-center w-16 h-16 rounded-full bg-brand-700 text-white mb-6 shadow-soft">
            {s.icon === 'calendar' && (
              <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            )}
            {s.icon === 'ruler' && (
              <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 17L17 3l4 4L7 21z"/><path d="M7 9l2 2M11 5l2 2M9 15l2 2M13 11l2 2"/></svg>
            )}
            {s.icon === 'check' && (
              <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 6L9 17l-5-5"/></svg>
            )}
            <span class="absolute -top-2 -right-2 inline-flex items-center justify-center w-7 h-7 rounded-full bg-white text-brand-700 text-sm font-bold border border-brand-200 shadow-sm">{s.n}</span>
          </div>
          <h3 class="font-display text-xl text-ink-800 mb-3">{s.title}</h3>
          <p class="text-ink-500 leading-relaxed text-[0.975rem] [&_a]:text-brand-600 [&_a:hover]:text-brand-500 [&_a]:underline [&_a]:underline-offset-2" set:html={s.body} />
        </div>
      ))}
    </div>

    <div class="text-center mt-12">
      <a href="/contact/" class="btn-primary btn-lg">Schedule Your Free Consultation</a>
      <p class="text-ink-400 text-sm mt-4">
        Or call <a href={SITE.phoneHref} class="font-semibold text-brand-700 hover:text-brand-800">{SITE.phone}</a>, evenings and weekends welcome.
      </p>
    </div>
  </div>
</section>
