---
import { AREAS } from '~/lib/site';

interface Props {
  heading?: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  heading = 'Find Us in the St. Pete Area',
  subtitle = 'We bring our premium design showroom directly to your home. Operating from our local workroom, our professionals provide expert fabric consultations, precise measurements, and white-glove installation throughout Pinellas County.',
  ctaLabel = 'See All Service Areas',
  ctaHref = '/areas/',
} = Astro.props;

// Curated marquee neighborhoods — keeps the right panel tight on mobile.
// The full 14-area list lives in the homepage neighborhood strip and on /areas/.
const FEATURED_SLUGS = ['st-petersburg', 'downtown-st-pete', 'snell-isle', 'st-pete-beach', 'clearwater', 'largo'];
const featured = FEATURED_SLUGS
  .map((slug) => AREAS.find((a) => a.slug === slug))
  .filter((a): a is (typeof AREAS)[number] => Boolean(a));
---

<section class="relative">
  <!-- Map background -->
  <div class="absolute inset-0">
    <img
      src="/images/st-pete-map.webp"
      alt="Custom Fabric Creations service area map — St. Petersburg and Pinellas County window treatments and upholstery coverage"
      title="Custom Fabric Creations service area map — St. Petersburg, FL"
      class="w-full h-full object-cover"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-white/40"></div>
  </div>

  <div class="relative container-site py-20 md:py-28">
    <div class="grid md:grid-cols-2 gap-0 max-w-5xl mx-auto shadow-soft">
      <div class="bg-white p-10 md:p-12">
        <p class="eyebrow" style="letter-spacing: 0.3em;">Our Service Areas</p>
        <h2 class="font-display text-3xl md:text-4xl text-ink-800 mb-6 leading-tight">{heading}</h2>
        <p class="text-ink-500 leading-relaxed mb-8">{subtitle}</p>
        <a href={ctaHref} class="btn-primary">{ctaLabel}</a>
      </div>

      <div class="bg-brand-500 text-white p-10 md:p-12">
        <h3 class="font-display text-3xl md:text-4xl mb-2 leading-tight text-white">Serving the St. Pete coast</h3>
        <p class="text-white/80 text-sm mb-7">Marquee neighborhoods we work in most often.</p>
        <div class="grid grid-cols-2 gap-x-6 gap-y-3.5 mb-7">
          {featured.map((a) => (
            <a
              href={`/areas/${a.slug}/`}
              class="text-white hover:text-white/70 transition duration-200 ease-out text-lg font-medium border-b border-white/0 hover:border-white/40 pb-1"
            >
              {a.title}
            </a>
          ))}
        </div>
        <a href="/areas/" class="inline-flex items-center gap-2 text-white font-semibold border-b border-white/40 hover:border-white pb-1 transition">
          See all {AREAS.length} neighborhoods
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 10h10M11 5l5 5-5 5"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Gold banner below -->
  <div class="bg-brand-500 text-white py-5">
    <div class="container-site text-center text-sm tracking-[0.25em] uppercase font-semibold">
      Serving St. Petersburg & Pinellas County
    </div>
  </div>
</section>
