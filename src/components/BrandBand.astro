---
import { BRANDS } from '~/lib/site';
---

<section class="py-16 bg-white">
  <div class="container-site text-center">
    <p class="eyebrow">Authorized dealer</p>
    <h3 class="font-display text-2xl md:text-3xl text-ink-800 mb-10">
      We partner with the industry’s most respected brands.
    </h3>
    <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
      {BRANDS.map((b) => (
        <a href="/brands/" class="text-ink-400 hover:text-brand-700 font-display text-xl md:text-2xl tracking-wide transition">
          {b.name}
        </a>
      ))}
    </div>
  </div>
</section>
