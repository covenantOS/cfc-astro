---
import { NAV, SITE, getLocationForPath } from '~/lib/site';

const { pathname } = Astro.url;
const isActive = (href: string) => pathname === href || (href !== '/' && pathname.startsWith(href));
const location = getLocationForPath(pathname);

const primary = NAV.filter(n => ['Home', 'Services', 'Areas', 'Gallery', 'Blog', 'About', 'Contact'].includes(n.label));
---

<!-- Utility top bar: reviews + service area + years + phone -->
<div class="bg-ink-900 text-white/85 text-[0.72rem] sm:text-xs border-b border-white/10">
  <div class="container-site flex items-center justify-between h-9 gap-3">
    <div class="flex items-center gap-3 sm:gap-5 min-w-0">
      <a href="/reviews/" class="inline-flex items-center gap-1.5 hover:text-brand-300 transition shrink-0">
        <span class="flex items-center gap-0.5 text-brand-400" aria-hidden="true">
          {[1, 2, 3, 4, 5].map(() => (
            <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          ))}
        </span>
        <span class="font-semibold whitespace-nowrap">5.0 Google Reviews</span>
      </a>
      <span class="hidden md:inline-flex items-center gap-1.5 text-white/70 whitespace-nowrap">
        <svg class="w-3.5 h-3.5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        Serving St. Petersburg &amp; Tampa Bay
      </span>
      <span class="hidden lg:inline-flex items-center gap-1.5 text-white/70 whitespace-nowrap">
        <svg class="w-3.5 h-3.5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="M15 14l1 8-4-2-4 2 1-8"/></svg>
        25+ Years · Since 2000
      </span>
    </div>
    <a href={location.phoneHref} class="inline-flex items-center gap-1.5 font-semibold hover:text-brand-300 transition shrink-0 whitespace-nowrap">
      <svg class="w-3.5 h-3.5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
      {location.phone}
    </a>
  </div>
</div>

<!-- Top gold rule -->
<div class="h-[6px] bg-brand-500"></div>

<header class="sticky top-0 z-50 bg-ink-900/95 backdrop-blur supports-[backdrop-filter]:bg-ink-900/90 border-b border-brand-500/10">
  <a href="#main" class="skip-link">Skip to main content</a>

  <div class="container-site flex items-center justify-between h-24 gap-6">
    <a href="/" class="flex items-center shrink-0" aria-label={SITE.name}>
      <img
        src="/images/logo.webp"
        alt="Custom Fabric Creations logo, St. Petersburg FL custom window treatments and upholstery"
        title="Custom Fabric Creations, St. Petersburg, FL"
        class="h-14 md:h-16 w-auto object-contain"
        width="300"
        height="78"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav class="hidden lg:flex items-center gap-8" aria-label="Primary">
      {primary.map((item) => (
        item.children ? (
          <div class="relative group">
            <a
              href={item.href}
              class:list={[
                'flex items-center gap-1 text-sm font-semibold tracking-wider uppercase transition py-8',
                isActive(item.href) ? 'text-brand-400' : 'text-white hover:text-brand-300',
              ]}
              style="letter-spacing: 0.05em;"
            >
              {item.label}
              <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M1.5 4L6 8L10.5 4"/>
              </svg>
            </a>
            <div class="absolute left-1/2 -translate-x-1/2 top-full opacity-0 invisible group-hover:opacity-100 group-hover:visible transition z-50">
              <div class="bg-ink-900 border border-brand-500/20 shadow-soft py-3 min-w-[280px]">
                {item.children.map((child) => (
                  child.divider ? (
                    <>
                      <div class="my-2 border-t border-white/10"></div>
                      <a
                        href={child.href}
                        class="block px-5 py-2.5 text-sm text-brand-400 font-semibold uppercase tracking-wider hover:bg-brand-500 hover:text-ink-900 transition"
                        style="letter-spacing: 0.06em;"
                      >
                        {child.label}
                      </a>
                    </>
                  ) : (
                    <a
                      href={child.href}
                      class:list={[
                        'block px-5 py-2.5 text-sm transition',
                        child.featured
                          ? 'text-white font-semibold hover:bg-brand-500 hover:text-ink-900'
                          : 'text-white/80 hover:bg-brand-500 hover:text-ink-900',
                      ]}
                    >
                      {child.label}
                    </a>
                  )
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={[
              'text-sm font-semibold tracking-wider uppercase transition py-8',
              isActive(item.href) ? 'text-brand-400' : 'text-white hover:text-brand-300',
            ]}
            style="letter-spacing: 0.05em;"
          >
            {item.label}
          </a>
        )
      ))}
    </nav>

    <div class="hidden md:flex items-center gap-3 shrink-0">
      <a href="/contact/" class="btn-primary">Schedule Consultation</a>
    </div>

    <button
      id="mobile-nav-toggle"
      class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded border border-brand-500/40 text-brand-400"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg id="mobile-nav-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg id="mobile-nav-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden">
        <line x1="6" y1="6" x2="18" y2="18"/>
        <line x1="18" y1="6" x2="6" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- Mobile overlay panel.
       - Fixed position so the page underneath does NOT scroll when interacting.
       - Sits below the 24-tall header (top-24) and the 6px gold rule (so total top = 6 + 96 = 102px).
       - Internal scroll via overflow-y-auto + max-height calc, so long lists fit any device.
       - Services/Areas use native <details> for accessible collapse with no JS deps.
       - Body scroll is locked via JS when open. -->
  <div
    id="mobile-nav"
    class="lg:hidden hidden fixed left-0 right-0 z-40 bg-ink-900 border-t border-brand-500/10"
    style="top: calc(6px + 6rem); height: calc(100dvh - 6px - 6rem); overflow-y: auto; overscroll-behavior: contain;"
  >
    <nav class="container-site py-6 flex flex-col" aria-label="Mobile">
      {NAV.map((item) => (
        item.children ? (
          <details class="group border-b border-white/5">
            <summary class="flex items-center justify-between py-4 cursor-pointer list-none select-none">
              <span class="font-semibold text-sm uppercase tracking-wide text-white" style="letter-spacing: 0.08em;">{item.label}</span>
              <span class="flex items-center gap-3">
                <a
                  href={item.href}
                  class="text-xs text-brand-400 hover:text-brand-300 underline underline-offset-2"
                  data-mobile-nav-link
                  onclick="event.stopPropagation();"
                >View all</a>
                <svg class="w-4 h-4 text-brand-400 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 8l5 5 5-5"/>
                </svg>
              </span>
            </summary>
            <ul class="pb-3">
              {item.children.map((c) => (
                c.divider ? (
                  <li class="mt-1 pt-2 border-t border-white/10">
                    <a
                      href={c.href}
                      class="block pl-4 pr-2 py-2.5 text-sm font-semibold uppercase tracking-wider text-brand-400 hover:text-brand-300 hover:bg-white/5 rounded-sm"
                      data-mobile-nav-link
                    >{c.label}</a>
                  </li>
                ) : (
                  <li>
                    <a
                      href={c.href}
                      class:list={[
                        'block pl-4 pr-2 py-2.5 text-sm hover:text-brand-300 hover:bg-white/5 rounded-sm',
                        c.featured ? 'text-white font-semibold' : 'text-white/80',
                      ]}
                      data-mobile-nav-link
                    >{c.label}</a>
                  </li>
                )
              ))}
            </ul>
          </details>
        ) : (
          <a
            href={item.href}
            class="block py-4 font-semibold text-sm uppercase tracking-wide text-white hover:text-brand-300 border-b border-white/5"
            style="letter-spacing: 0.08em;"
            data-mobile-nav-link
          >{item.label}</a>
        )
      ))}

      <a href="/reviews/" class="block py-4 font-semibold text-sm uppercase tracking-wide text-white hover:text-brand-300 border-b border-white/5" style="letter-spacing: 0.08em;" data-mobile-nav-link>Reviews</a>

      <a href="/contact/" class="btn-primary mt-6" data-mobile-nav-link>Schedule Consultation</a>

      <a href={location.phoneHref} class="mt-3 text-center text-brand-400 font-semibold py-2 hover:text-brand-300" data-mobile-nav-link>Call {location.phone}</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const panel = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('mobile-nav-icon-open');
  const iconClose = document.getElementById('mobile-nav-icon-close');

  // Tracks the scroll position so we can restore it when the menu closes.
  // Using the position-fixed pattern (rather than `overflow: hidden`) because
  // our html/body already set `overflow-x: clip`, and mixing that with an
  // inline `overflow: hidden` can leave iOS Safari in a stuck-scroll state
  // after the inline rule is removed.
  let savedScrollY = 0;
  let isOpen = false;

  function lockScroll() {
    savedScrollY = window.scrollY || window.pageYOffset || 0;
    document.body.style.position = 'fixed';
    document.body.style.top = `-${savedScrollY}px`;
    document.body.style.left = '0';
    document.body.style.right = '0';
    document.body.style.width = '100%';
  }

  function unlockScroll() {
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.left = '';
    document.body.style.right = '';
    document.body.style.width = '';
    // Restore the user's scroll position synchronously (positional scrollTo
    // skips the smooth-scroll behavior from `html { scroll-behavior: smooth }`).
    window.scrollTo(0, savedScrollY);
  }

  function setOpen(open: boolean) {
    if (!panel || !toggle) return;
    if (open === isOpen) return;
    isOpen = open;
    panel.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    if (open) lockScroll();
    else unlockScroll();
  }

  toggle?.addEventListener('click', () => setOpen(!isOpen));

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) setOpen(false);
  });

  // Close after tapping any link so navigation feels smooth on slow connections.
  // We unlock scroll first so iOS Safari doesn't carry the lock into the next
  // page if navigation is interrupted or slow.
  document.querySelectorAll<HTMLElement>('[data-mobile-nav-link]').forEach((el) => {
    el.addEventListener('click', () => setOpen(false));
  });

  // If the user resizes from mobile to desktop with the menu open, reset state
  const mq = window.matchMedia('(min-width: 1024px)');
  mq.addEventListener('change', (e) => { if (e.matches && isOpen) setOpen(false); });

  // Belt-and-suspenders: if the page is restored from the bfcache or otherwise
  // shown again with a stale lock, force-unlock on pageshow.
  window.addEventListener('pageshow', () => {
    if (document.body.style.position === 'fixed') {
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
    }
  });
</script>
