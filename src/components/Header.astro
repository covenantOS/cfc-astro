---
import { NAV, SITE } from '~/lib/site';

const { pathname } = Astro.url;
const isActive = (href: string) => pathname === href || (href !== '/' && pathname.startsWith(href));
---

<!-- Top gold rule -->
<div class="h-[6px] bg-brand-500"></div>

<header class="sticky top-0 z-50 bg-ink-900/95 backdrop-blur supports-[backdrop-filter]:bg-ink-900/85 border-b border-brand-700/20">
  <a href="#main" class="skip-link">Skip to main content</a>

  <div class="container-site flex items-center justify-between h-20 gap-6">
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label={SITE.name}>
      <span class="font-display italic text-2xl md:text-3xl text-brand-400 tracking-wide leading-none">
        Custom Fabric Creations
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-8" aria-label="Primary">
      {NAV.filter(n => ['Home', 'Services', 'Areas', 'Gallery', 'About', 'Contact'].includes(n.label)).map((item) => (
        item.children ? (
          <div class="relative group">
            <a
              href={item.href}
              class:list={[
                'flex items-center gap-1 text-sm font-semibold tracking-wider uppercase transition py-8',
                isActive(item.href) ? 'text-brand-400' : 'text-white hover:text-brand-300',
              ]}
              style="letter-spacing: 0.05em;"
            >
              {item.label}
              <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M1.5 4L6 8L10.5 4"/>
              </svg>
            </a>
            <div class="absolute left-1/2 -translate-x-1/2 top-full opacity-0 invisible group-hover:opacity-100 group-hover:visible transition z-50">
              <div class="bg-ink-900 border border-brand-700/30 shadow-soft py-3 min-w-[280px]">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class="block px-5 py-2.5 text-sm text-white/80 hover:bg-brand-500 hover:text-ink-900 transition"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={[
              'text-sm font-semibold tracking-wider uppercase transition py-8',
              isActive(item.href) ? 'text-brand-400' : 'text-white hover:text-brand-300',
            ]}
            style="letter-spacing: 0.05em;"
          >
            {item.label}
          </a>
        )
      ))}
    </nav>

    <div class="hidden md:flex items-center gap-3 shrink-0">
      <a href="/contact/" class="btn-primary">Schedule Consultation</a>
    </div>

    <button
      id="mobile-nav-toggle"
      class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded border border-brand-500/40 text-brand-400"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>

  <div id="mobile-nav" class="lg:hidden hidden border-t border-brand-700/20 bg-ink-900">
    <nav class="container-site py-4 flex flex-col" aria-label="Mobile">
      {NAV.flatMap((item) =>
        item.children
          ? [
              <div class="py-2 font-semibold text-sm uppercase tracking-wide text-brand-400" style="letter-spacing: 0.08em;">{item.label}</div>,
              ...item.children.map((c) => (
                <a href={c.href} class="pl-4 py-2 text-white/80 hover:text-brand-300">{c.label}</a>
              )),
            ]
          : [
              <a href={item.href} class="py-2 font-semibold text-sm uppercase tracking-wide text-white hover:text-brand-300" style="letter-spacing: 0.08em;">{item.label}</a>,
            ]
      )}
      <a href="/contact/" class="btn-primary mt-4">Schedule Consultation</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const panel = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const isOpen = panel?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });
</script>
