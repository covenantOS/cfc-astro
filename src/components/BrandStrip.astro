---
interface Stat {
  value: string;
  label: string;
}
interface Props {
  stats?: Stat[];
  showBend?: boolean;
}

const {
  stats = [
    { value: '25+', label: 'Years Experience' },
    { value: '100%', label: 'Satisfaction' },
    { value: 'FL', label: 'Serving St. Pete Metro' },
  ],
  showBend = true,
} = Astro.props;

const brands = [
  { name: 'Norman Shutters', src: '/images/brands/Norman-Shutters.webp' },
  { name: 'Stout Textiles', src: '/images/brands/Stout.webp' },
  { name: 'Kravet', src: '/images/brands/Kravet-Fabric.webp' },
  { name: 'Horizons Window Fashions', src: '/images/brands/Horizon Window Fashions.webp' },
  { name: 'Hunter Douglas', src: '/images/brands/Hunter Douglas.webp' },
  { name: 'ALTA Window Fashions', src: '/images/brands/ALTA Window Fashions.webp' },
  { name: 'Elegant Shutters', src: '/images/brands/Elegant Shutters.webp' },
];
---

<section class="relative bg-white">
  {showBend && (
    <div class="absolute top-0 left-0 right-0 h-16 md:h-20 pointer-events-none" aria-hidden="true">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none" class="w-full h-full block">
        <path d="M0,0 L0,10 Q720,80 1440,10 L1440,0 Z" fill="#1a1a1a"/>
        <path d="M0,10 Q720,80 1440,10" fill="none" stroke="#bca050" stroke-width="3"/>
      </svg>
    </div>
  )}

  <div class="pt-24 pb-16 md:pt-28 md:pb-20">
    <div class="container-site">
      <div class="grid grid-cols-3 gap-6 max-w-2xl mx-auto mb-14">
        {stats.map((s) => (
          <div class="text-center">
            <p class="font-display text-3xl md:text-4xl text-brand-600 mb-1">{s.value}</p>
            <p class="text-xs tracking-[0.2em] uppercase text-ink-500">{s.label}</p>
          </div>
        ))}
      </div>

      <div class="flex flex-wrap items-center justify-center gap-x-12 md:gap-x-16 gap-y-8">
        {brands.map((b) => (
          <img
            src={b.src}
            alt={b.name}
            class="h-10 md:h-12 max-w-[160px] w-auto object-contain"
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>

      <p class="text-center mt-10">
        <a href="/brands/" class="text-sm text-brand-600 hover:text-brand-700 underline underline-offset-4 font-semibold">
          See full list of brands
        </a>
      </p>
    </div>
  </div>
</section>
