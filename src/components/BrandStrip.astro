---
interface Stat {
  value: string;
  label: string;
}
interface Props {
  stats?: Stat[];
  showBend?: boolean;
}

const {
  stats = [
    { value: '25+', label: 'Years Experience' },
    { value: '100%', label: 'Satisfaction' },
    { value: 'FL', label: 'Serving St. Pete Metro' },
  ],
  showBend = true,
} = Astro.props;

const brands = [
  { name: 'Norman Shutters', src: '/images/brands/Norman-Shutters.webp', w: 400, h: 102 },
  { name: 'Stout Textiles', src: '/images/brands/stout.webp', w: 344, h: 141 },
  { name: 'Kravet', src: '/images/brands/Kravet-Fabric.webp', w: 400, h: 142 },
  { name: 'Horizons Window Fashions', src: '/images/brands/Horizon Window Fashions.webp', w: 387, h: 107 },
  { name: 'Hunter Douglas', src: '/images/brands/Hunter Douglas.webp', w: 400, h: 267 },
  { name: 'ALTA Window Fashions', src: '/images/brands/ALTA Window Fashions.webp', w: 400, h: 120 },
  { name: 'Elegant Shutters', src: '/images/brands/Elegant Shutters.webp', w: 400, h: 85 },
];
---

<section class="relative bg-white">
  {showBend && (
    <div class="absolute top-0 left-0 right-0 h-24 md:h-36 pointer-events-none overflow-hidden" aria-hidden="true">
      <svg viewBox="0 0 1440 180" preserveAspectRatio="none" class="w-full h-full block">
        <!-- Circular dip: dark arcs down into white -->
        <path d="M0,0 L0,40 A 1800 1800 0 0 0 1440 40 L1440,0 Z" fill="#1a1a1a"/>
        <path d="M0,40 A 1800 1800 0 0 0 1440 40" fill="none" stroke="#bca050" stroke-width="4" vector-effect="non-scaling-stroke"/>
      </svg>
    </div>
  )}

  <div class="pt-24 pb-16 md:pt-28 md:pb-20">
    <div class="container-site">
      <div class="grid grid-cols-3 gap-6 max-w-2xl mx-auto mb-14">
        {stats.map((s) => (
          <div class="text-center">
            <p class="font-display text-3xl md:text-4xl font-semibold text-brand-600 mb-1">{s.value}</p>
            <p class="text-[0.72rem] tracking-[0.22em] uppercase text-ink-600 font-semibold">{s.label}</p>
          </div>
        ))}
      </div>

      <div class="flex flex-wrap items-center justify-center gap-x-12 md:gap-x-16 gap-y-8">
        {brands.map((b) => (
          <img
            src={b.src}
            alt={`${b.name}, authorized dealer brand carried by Custom Fabric Creations, St. Petersburg, FL`}
            title={`${b.name} | Custom Fabric Creations, St. Petersburg, FL`}
            width={b.w}
            height={b.h}
            class="h-10 md:h-12 max-w-[160px] w-auto object-contain"
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>

      <p class="text-center mt-10">
        <a href="/brands/" class="text-sm text-brand-700 hover:text-brand-800 underline underline-offset-4 font-semibold">
          See full list of brands
        </a>
      </p>
    </div>
  </div>
</section>
