---
import { AREAS } from '~/lib/site';

interface Props {
  heading?: string;
  eyebrow?: string;
  subtitle?: string;
}

const {
  heading = 'Serving the St. Petersburg Area',
  eyebrow = 'Our neighborhoods',
  subtitle,
} = Astro.props;
---

<section class="py-20 md:py-28 bg-cream-50">
  <div class="container-site">
    <div class="text-center max-w-2xl mx-auto mb-14">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 class="font-display text-4xl md:text-5xl title-rule">{heading}</h2>
      {subtitle && <p class="mt-6 text-ink-500 text-lg leading-relaxed">{subtitle}</p>}
    </div>

    <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {AREAS.map((a) => (
        <a
          href={`/areas/${a.slug}/`}
          class="group flex items-center justify-between bg-white rounded-lg shadow-card px-5 py-4 hover:border-brand-500 transition"
        >
          <span class="text-ink-700 font-medium group-hover:text-brand-700">{a.title}</span>
          <svg class="w-4 h-4 text-brand-500 transition group-hover:translate-x-1" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 10h10M11 5l5 5-5 5"/>
          </svg>
        </a>
      ))}
    </div>
  </div>
</section>
