---
import { SITE } from '~/lib/site';
import HeroBend from './HeroBend.astro';

interface Props {
  eyebrow?: string;
  title: string;
  /** Optional gold-accent tail appended after `title`. Used to do the two-tone
   *  Westchase-style headline (white start, gold finish). Renders inline. */
  titleAccent?: string;
  subtitle?: string;
  image?: string;
  video?: string;
  imageAlt?: string;
  imageTitle?: string;
  bullets?: string[];
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  trustBar?: boolean;
  showRating?: boolean;
  breadcrumbs?: Array<{ name: string; url: string }>;
  variant?: 'image' | 'linen';
  size?: 'default' | 'tall';
  bend?: boolean;
  bendColor?: string;
  goldLine?: boolean;
}

const {
  eyebrow,
  title,
  titleAccent,
  subtitle,
  image,
  video,
  imageAlt,
  imageTitle,
  bullets = [],
  primaryCta,
  secondaryCta,
  trustBar = false,
  showRating = false,
  breadcrumbs,
  variant = 'image',
  size = 'default',
  bend = false,
  bendColor = '#ffffff',
  goldLine = false,
} = Astro.props;

const padding = size === 'tall' ? 'py-16 sm:py-24 md:py-40 lg:py-48' : 'py-10 sm:py-16 md:py-28 lg:py-36';

// When the caller fills the `aside` slot (e.g. contact page form), the hero
// switches from centered text to a desktop two-column layout: text left,
// aside card right. On mobile/tablet the aside stacks below.
const hasAside = Astro.slots.has('aside');

// Build a keyword-rich alt + title if caller didn't supply one.
// Every Custom Fabric Creations hero image gets a descriptive, brand-tagged alt.
const derivedAlt = imageAlt ?? `${title}, Custom Fabric Creations St. Petersburg, FL`;
const derivedTitle = imageTitle ?? derivedAlt;
---

<section class:list={['relative overflow-hidden', variant === 'linen' && 'bg-linen']}>
  {variant === 'image' && video && (
    <div class="absolute inset-0">
      <video
        src={video}
        poster={image}
        autoplay
        muted
        loop
        playsinline
        class="w-full h-full object-cover"
        preload="auto"
        title={derivedTitle}
        aria-label={derivedAlt}
      ></video>
      <div class="absolute inset-0 bg-gradient-to-b from-ink-900/65 via-ink-900/55 to-ink-900/75"></div>
    </div>
  )}
  {variant === 'image' && !video && image && (
    <div class="absolute inset-0">
      <img
        src={image}
        alt={derivedAlt}
        title={derivedTitle}
        class="w-full h-full object-cover"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-ink-900/70 via-ink-900/60 to-ink-900/80"></div>
    </div>
  )}

  <div class:list={[
    'relative container-site',
    padding,
    hasAside
      ? 'text-center lg:text-left lg:grid lg:grid-cols-[1fr_minmax(360px,440px)] lg:items-center lg:gap-12'
      : 'text-center',
  ]}>
    <div class:list={[hasAside && 'lg:col-start-1 lg:min-w-0']}>
    {breadcrumbs && breadcrumbs.length > 0 && (
      <nav class:list={[
        'mb-6 flex items-center gap-2.5 text-sm md:text-base tracking-wide text-white/85 font-medium',
        hasAside ? 'justify-center lg:justify-start' : 'justify-center',
      ]} aria-label="Breadcrumb">
        {breadcrumbs.map((b, i) => (
          <>
            {i > 0 && <span class="text-brand-400">/</span>}
            {i === breadcrumbs.length - 1 ? (
              <span class="text-brand-300">{b.name}</span>
            ) : (
              <a href={b.url} class="hover:text-brand-300 transition">{b.name}</a>
            )}
          </>
        ))}
      </nav>
    )}

    <div class:list={[
      'flex flex-col max-w-xl',
      hasAside ? 'mx-auto items-center lg:mx-0 lg:items-start' : 'mx-auto items-center',
    ]}>
      {showRating && (
        <div class="mb-4 inline-flex items-center justify-center gap-2 rounded-full px-3.5 py-1.5 border border-brand-400/40 w-auto max-w-max whitespace-nowrap" style="background-color: rgba(188, 160, 80, 0.18); backdrop-filter: blur(8px);">
          <div class="flex items-center gap-0.5 text-brand-400 shrink-0" aria-hidden="true">
            {[1,2,3,4,5].map(() => (
              <svg class="w-3 h-3 md:w-3.5 md:h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <span class="text-xs md:text-sm text-white font-semibold tracking-wide">5.0 · Verified Reviews</span>
        </div>
      )}

      {eyebrow && (
        <p class:list={[
          'flex items-center gap-3 mb-5',
          hasAside ? 'justify-center lg:justify-start' : 'justify-center',
          variant === 'image' ? 'text-brand-300' : 'text-brand-700',
        ]}>
          <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          <span class="text-xs font-semibold uppercase" style="letter-spacing: 0.3em;">{eyebrow}</span>
          <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        </p>
      )}
    </div>

    <h1 class:list={[
      'font-display max-w-5xl leading-[1.05]',
      hasAside ? 'mx-auto lg:mx-0' : 'mx-auto',
      size === 'tall' ? 'text-[2rem] sm:text-5xl md:text-6xl lg:text-6xl xl:text-7xl' : 'text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl',
      variant === 'image' ? 'text-white' : 'text-ink-800',
    ]}>
      {title}{titleAccent && (
        <>
          {' '}<span class="text-brand-400">{titleAccent}</span>
        </>
      )}
    </h1>

    {subtitle && (
      <p class:list={[
        'mt-4 sm:mt-6 text-base sm:text-lg md:text-xl max-w-3xl leading-relaxed',
        hasAside ? 'mx-auto lg:mx-0' : 'mx-auto',
        variant === 'image' ? 'text-white/90' : 'text-ink-600',
      ]} set:html={subtitle}></p>
    )}

    {bullets.length > 0 && (
      <ul class:list={[
        'mt-5 sm:mt-8 flex flex-wrap gap-x-6 sm:gap-x-8 gap-y-2 sm:gap-y-3 text-sm',
        hasAside ? 'justify-center lg:justify-start' : 'justify-center',
      ]}>
        {bullets.map((b) => (
          <li class:list={['flex items-center gap-2', variant === 'image' ? 'text-white' : 'text-ink-600']}>
            <svg class="w-4 h-4 text-brand-400" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 10l3 3 7-7"/>
            </svg>
            <span class="font-medium">{b}</span>
          </li>
        ))}
      </ul>
    )}

    {(primaryCta || secondaryCta) && (
      <div class:list={[
        'mt-6 sm:mt-10 cta-group',
        hasAside && 'cta-aside',
      ]}>
        {primaryCta && <a href={primaryCta.href} class="btn-primary btn-lg">{primaryCta.label}</a>}
        {secondaryCta && (
          <a
            href={secondaryCta.href}
            class:list={[variant === 'image' ? 'btn-outline btn-lg' : 'btn-ghost btn-lg']}
          >{secondaryCta.label}</a>
        )}
      </div>
    )}

    {trustBar && (
      <div class:list={[
        'mt-8 sm:mt-12 flex flex-wrap items-center gap-x-8 sm:gap-x-10 gap-y-3 sm:gap-y-4 text-sm',
        hasAside ? 'justify-center lg:justify-start' : 'justify-center',
      ]}>
        {[
          { icon: 'shield', label: 'Fully Insured' },
          { icon: 'award', label: 'Master Craftsmanship' },
          { icon: 'home', label: 'Locally Owned' },
        ].map((item) => (
          <div class:list={['inline-flex items-center gap-2', variant === 'image' ? 'text-white/90' : 'text-ink-600']}>
            {item.icon === 'shield' && (
              <svg class="w-4 h-4 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L4 6v6c0 5.5 3.5 10 8 11 4.5-1 8-5.5 8-11V6l-8-4z"/>
              </svg>
            )}
            {item.icon === 'award' && (
              <svg class="w-4 h-4 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="8" r="6"/>
                <path d="M15 14l1 8-4-2-4 2 1-8"/>
              </svg>
            )}
            {item.icon === 'home' && (
              <svg class="w-4 h-4 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 12l9-9 9 9M5 10v10h14V10"/>
              </svg>
            )}
            <span class="font-semibold">{item.label}</span>
          </div>
        ))}
      </div>
    )}
    </div>
    {hasAside && (
      <aside class="mt-10 lg:mt-0 lg:col-start-2 text-left">
        <slot name="aside" />
      </aside>
    )}
  </div>
</section>

{goldLine && <div class="h-[3px] w-full bg-brand-500"></div>}
{bend && <HeroBend nextBg={bendColor} />}
