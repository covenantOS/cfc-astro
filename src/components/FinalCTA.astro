---
import { SITE } from '~/lib/site';

interface Review {
  rating: number;
  body: string;
  name: string;
}

interface Props {
  heading?: string;
  subtitle?: string;
  eyebrow?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  reviewStripLabel?: string;
  reviews?: Review[];
}

const {
  heading = 'Ready to Bring Your Vision to Life?',
  subtitle = 'Avoid mass-produced alternatives. Partner with the premier design studio in St. Pete for bespoke window treatments and master upholstery perfectly tailored to your living space.',
  eyebrow = 'Take the Next Step',
  primary = { label: 'Schedule Consultation', href: '/contact/' },
  secondary = { label: `Call ${SITE.phone}`, href: SITE.phoneHref },
  reviewStripLabel = 'Trusted by hundreds around the St. Pete coast',
  reviews = [
    {
      rating: 5,
      body: "I have been working with Terry and her team for years. Very talented decorator with beautiful and unique designs. The quality of her products is superior. I love working with her on my projects because she listens to what I want to do and goes far past my expectations. Just a true delight to work with. The best part — she always stayed in my budget for every project.",
      name: 'Patty Profeto',
    },
    {
      rating: 5,
      body: "Terry and team did an amazing job reupholstering my 10-1/2 foot bench. The quality of work, communication, and speed were A++. Thank you!",
      name: 'Beth McCarthy',
    },
    {
      rating: 5,
      body: "Terry was a blast and very professional. I had her and her team make custom curtains for my mom's outdoor sitting area. She came over and helped us go through fabric choices. In the end my mom is very pleased. I would recommend them.",
      name: 'Amy Monroe',
    },
  ],
} = Astro.props;
---

<!-- Dark CTA band -->
<section class="py-20 md:py-28 bg-cream text-ink-800 text-center">
  <div class="container-narrow">
    {eyebrow && <p class="eyebrow" style="letter-spacing: 0.3em;">{eyebrow}</p>}
    <h2 class="font-display text-4xl md:text-5xl lg:text-6xl leading-tight mb-6">{heading}</h2>
    <p class="text-ink-500 text-lg leading-relaxed max-w-2xl mx-auto mb-8">{subtitle}</p>
    <div class="cta-group">
      <a href={primary.href} class="btn-primary btn-lg">{primary.label}</a>
      <a href={secondary.href} class="btn-ghost btn-lg">{secondary.label}</a>
    </div>
  </div>
</section>

