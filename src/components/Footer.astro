---
import { SITE, SERVICES, AREAS } from '~/lib/site';
const year = new Date().getFullYear();
---

<footer class="bg-ink-900 text-white">
  <div class="container-site py-16 md:py-20 grid gap-12 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <div class="font-display italic text-3xl text-brand-400 mb-5 leading-tight">
        Custom Fabric Creations
      </div>
      <p class="text-sm text-white/75 leading-relaxed mb-6">
        We’d love to help you design the space of your dreams. Whether you’re looking for interior or exterior shades with motorization options, custom drapes and top treatments or re-upholstery.
      </p>
      <a href="/contact/" class="btn-primary mb-7 inline-flex">Schedule Consultation</a>
      <div class="space-y-5 text-sm">
        <div class="flex items-start gap-3">
          <span class="icon-badge-sm bg-white/10">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
            </svg>
          </span>
          <div>
            <p class="text-white/60 text-xs uppercase tracking-widest mb-1">Call us</p>
            <a href={SITE.phoneHref} class="block text-brand-400 font-bold hover:text-brand-300 text-base">{SITE.phone}</a>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="icon-badge-sm bg-white/10">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
            </svg>
          </span>
          <div>
            <p class="text-white/60 text-xs uppercase tracking-widest mb-1">Hours</p>
            <p class="text-white/80">Monday–Friday, 7am–5pm</p>
            <p class="text-white/80">Saturday–Sunday, 8am–5pm</p>
          </div>
        </div>
      </div>
    </div>

    <div>
      <h4 class="text-brand-400 font-display text-xl mb-5">Website</h4>
      <ul class="space-y-3 text-sm">
        <li><a href="/" class="text-white/80 hover:text-brand-300">Home</a></li>
        <li><a href="/about/" class="text-white/80 hover:text-brand-300">About</a></li>
        <li><a href="/gallery/" class="text-white/80 hover:text-brand-300">Gallery</a></li>
        <li><a href="/reviews/" class="text-white/80 hover:text-brand-300">Reviews</a></li>
        <li><a href="/brands/" class="text-white/80 hover:text-brand-300">Brands</a></li>
        <li><a href="/contact/" class="text-white/80 hover:text-brand-300">Contact</a></li>
        <li><a href="/plantation-shutters-near-me/" class="text-white/80 hover:text-brand-300">Plantation Shutters Near Me</a></li>
        <li><a href="/drapery-near-me/" class="text-white/80 hover:text-brand-300">Drapery Near Me</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-brand-400 font-display text-xl mb-5">Services</h4>
      <ul class="space-y-3 text-sm">
        {SERVICES.slice(0, 5).map((s) => (
          <li><a href={`/services/${s.slug}/`} class="text-white/80 hover:text-brand-300">{s.title}</a></li>
        ))}
        <li>
          <a href="/services/" class="text-brand-400 font-semibold hover:text-brand-300 inline-flex items-center gap-1">
            See More
            <svg class="w-3 h-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 10h10M11 5l5 5-5 5"/></svg>
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h4 class="text-brand-400 font-display text-xl mb-5">Areas</h4>
      <ul class="space-y-3 text-sm">
        {AREAS.slice(0, 5).map((a) => (
          <li><a href={`/areas/${a.slug}/`} class="text-white/80 hover:text-brand-300">{a.title}</a></li>
        ))}
        <li>
          <a href="/areas/" class="text-brand-400 font-semibold hover:text-brand-300 inline-flex items-center gap-1">
            See More
            <svg class="w-3 h-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 10h10M11 5l5 5-5 5"/></svg>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-site py-5 flex flex-col md:flex-row items-center justify-between gap-3 text-xs">
      <p class="text-white/60">Copyright &copy; {year} · {SITE.name} LLC</p>
      <div class="flex items-center gap-5 text-white/70">
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-4 h-4 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
          Fully Insured
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-4 h-4 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
          Locally Owned
        </span>
      </div>
    </div>
  </div>
</footer>
