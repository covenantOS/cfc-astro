---
interface Feature {
  title: string;
  body: string;
  icon?: string;
}

interface Props {
  heading?: string;
  eyebrow?: string;
  features: Feature[];
}

const { heading, eyebrow, features } = Astro.props;
---

<section class="py-20 md:py-28 bg-white">
  <div class="container-site">
    {(heading || eyebrow) && (
      <div class="text-center max-w-2xl mx-auto mb-14">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {heading && <h2 class="font-display text-4xl md:text-5xl title-rule">{heading}</h2>}
      </div>
    )}
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      {features.map((f) => (
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-brand-50 border border-brand-100 text-brand-600 mb-5">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M20 6L9 17l-5-5"/>
            </svg>
          </div>
          <h3 class="font-display text-xl text-ink-800 mb-3">{f.title}</h3>
          <p class="text-ink-500 leading-relaxed text-[0.95rem]">{f.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
