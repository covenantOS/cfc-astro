---
// Google reviews section, Titan-style layout.
// - Trust pill at top: Google G + 5.0 + 5 stars + qualitative copy (no count).
// - Featured review card: large, single review at a time, JS-driven carousel.
// - Carousel dot indicators below.
// - 4-card row of smaller reviews below the carousel.
// - Stats bar at bottom: Rating, Years, In-House Workroom.
// - "Reviews sourced from Google" footer with mini G logo.
//
// Per client decision 2026-05-20: NO review count anywhere in this section.
// Suzanne Rice excluded upstream (no body) in src/data/reviews.ts.

import { REVIEWS, getFeaturedReview, getReviewsByRecency } from '~/data/reviews';

interface Props {
  heading?: string;
  subheading?: string;
  trustCopy?: string;
  googleHref?: string;
}

const GOOGLE_HREF = 'https://www.google.com/search?q=custom+fabric+creations+st+petersburg';

const {
  heading = 'Trusted by St. Pete Homeowners',
  subheading = 'Licensed, Insured & Locally Owned · Serving Pinellas County since 2000',
  trustCopy = 'Verified 5-star Google reviews',
  googleHref = GOOGLE_HREF,
} = Astro.props;

const featured = getFeaturedReview();
// Carousel pool: every review including the featured one, sorted most-recent
// first so the rotation reads as fresh.
const carouselReviews = getReviewsByRecency();
// 4-card row: the 4 most recent reviews that are NOT the currently-featured
// review (to avoid the same review showing twice on first paint).
const grid = getReviewsByRecency().filter((r) => r.id !== featured.id).slice(0, 4);
---

<section class="py-20 md:py-28 bg-cream-50">
  <div class="container-site">

    <!-- Section heading -->
    <div class="text-center max-w-2xl mx-auto mb-10">
      <p class="eyebrow" style="letter-spacing: 0.3em;">Reviews</p>
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl text-ink-800 mb-5 leading-tight">{heading}</h2>
      <p class="text-ink-500 text-sm md:text-base">{subheading}</p>
    </div>

    <!-- Trust pill (Titan-style floating card): G logo + 5.0 + 5 stars + copy.
         No numeric review count per client decision. -->
    <div class="flex justify-center mb-10">
      <div class="inline-flex items-center gap-3 md:gap-4 bg-white rounded-lg shadow-card px-4 md:px-6 py-3">
        <svg class="w-8 h-8 md:w-10 md:h-10 shrink-0" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20c11 0 20-8 20-20 0-1.3-.1-2.3-.4-3.5z"/>
          <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.1 18.9 12 24 12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
          <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35 26.7 36 24 36c-5.2 0-9.7-3.3-11.3-8l-6.5 5C9.4 39.6 16.1 44 24 44z"/>
          <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.2 5.6l6.2 5.2C41.4 35.5 44 30.2 44 24c0-1.3-.1-2.3-.4-3.5z"/>
        </svg>
        <div class="flex flex-col">
          <div class="flex items-center gap-2">
            <span class="font-display text-xl md:text-2xl text-ink-800 font-bold tabular-nums leading-none">5.0</span>
            <div class="flex items-center gap-0.5 text-[#FBBC04]" aria-label="5 out of 5 stars">
              {[1,2,3,4,5].map(() => (
                <svg class="w-3.5 h-3.5 md:w-4 md:h-4" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
          </div>
          <p class="text-[0.7rem] md:text-xs text-ink-500 mt-0.5 whitespace-nowrap">{trustCopy}</p>
        </div>
      </div>
    </div>

    <!-- Featured-review carousel.
         Each slide is rendered as a full review card. JS rotates by toggling
         a `data-active="true"` attribute on one slide at a time. Dots below
         click to jump. Pauses on hover. Pure DOM, no framework. -->
    <div class="max-w-3xl mx-auto mb-6" data-review-carousel>
      <div class="relative">
        <!-- Prev / next arrows. Visible on all sizes; positioned just
             outside the card on desktop, overlaid at the edges on mobile. -->
        <button
          type="button"
          data-review-prev
          aria-label="Previous review"
          class="absolute left-0 lg:-left-5 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white shadow-card border border-coffee-200/70 flex items-center justify-center text-ink-700 hover:text-brand-600 hover:border-brand-300 transition"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button
          type="button"
          data-review-next
          aria-label="Next review"
          class="absolute right-0 lg:-right-5 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white shadow-card border border-coffee-200/70 flex items-center justify-center text-ink-700 hover:text-brand-600 hover:border-brand-300 transition"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </button>

        {carouselReviews.map((r, i) => (
          <article
            class="review-slide bg-white rounded-lg shadow-card p-8 md:p-10"
            data-slide-index={i}
            data-active={i === 0 ? 'true' : 'false'}
          >
            <header class="flex items-center justify-between mb-5">
              <div class="flex items-center gap-3">
                {r.avatar ? (
                  <img
                    src={r.avatar}
                    alt=""
                    class="w-12 h-12 rounded-full object-cover shrink-0"
                    width="48"
                    height="48"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div
                    class="w-12 h-12 rounded-full flex items-center justify-center text-white font-bold text-sm shrink-0"
                    style={`background-color: ${r.avatarColor};`}
                    aria-hidden="true"
                  >{r.initials}</div>
                )}
                <div>
                  <p class="font-bold text-ink-800 text-base leading-tight">{r.name}</p>
                  <div class="flex items-center gap-2 mt-1">
                    <div class="flex items-center gap-0.5 text-[#FBBC04]" aria-label={`${r.rating} out of 5 stars`}>
                      {Array.from({ length: r.rating }).map(() => (
                        <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                      ))}
                    </div>
                    <span class="text-ink-400 text-xs">·</span>
                    <span class="text-ink-400 text-xs">{r.dateLabel}</span>
                  </div>
                </div>
              </div>
              <svg class="w-6 h-6 shrink-0" viewBox="0 0 48 48" aria-label="Google review">
                <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20c11 0 20-8 20-20 0-1.3-.1-2.3-.4-3.5z"/>
                <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.1 18.9 12 24 12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
                <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35 26.7 36 24 36c-5.2 0-9.7-3.3-11.3-8l-6.5 5C9.4 39.6 16.1 44 24 44z"/>
                <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.2 5.6l6.2 5.2C41.4 35.5 44 30.2 44 24c0-1.3-.1-2.3-.4-3.5z"/>
              </svg>
            </header>
            <p class="text-ink-700 leading-relaxed text-base md:text-lg">{r.body}</p>
          </article>
        ))}
      </div>

      <!-- Carousel dots -->
      <div class="flex items-center justify-center gap-2 mt-6" data-review-dots>
        {carouselReviews.map((_, i) => (
          <button
            type="button"
            class="review-dot w-3 h-3 rounded-full transition cursor-pointer"
            data-dot-index={i}
            aria-label={`Show review ${i + 1}`}
          ></button>
        ))}
      </div>
    </div>

    <!-- 4-card row beneath the carousel: smaller cards, truncated body.
         Hidden under md to keep the mobile carousel tight; on md+ they show
         as a quick scan of additional reviews. -->
    <div class="hidden md:grid gap-5 md:grid-cols-2 lg:grid-cols-4 mb-12">
      {grid.map((r) => (
        <article class="bg-white rounded-lg shadow-card p-5 transition hover:shadow-card-hover hover:-translate-y-0.5">
          <header class="flex items-start justify-between gap-3 mb-3">
            <div class="flex items-center gap-2.5 min-w-0">
              {r.avatar ? (
                <img
                  src={r.avatar}
                  alt=""
                  class="w-9 h-9 rounded-full object-cover shrink-0"
                  width="36"
                  height="36"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div
                  class="w-9 h-9 rounded-full flex items-center justify-center text-white font-bold text-[0.7rem] shrink-0"
                  style={`background-color: ${r.avatarColor};`}
                  aria-hidden="true"
                >{r.initials}</div>
              )}
              <div class="min-w-0">
                <p class="font-bold text-ink-800 text-sm leading-tight truncate">{r.name}</p>
                <div class="flex items-center gap-1.5 mt-0.5">
                  <div class="flex items-center gap-0.5 text-[#FBBC04]" aria-label={`${r.rating} out of 5 stars`}>
                    {Array.from({ length: r.rating }).map(() => (
                      <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                      </svg>
                    ))}
                  </div>
                  <span class="text-ink-400 text-[0.7rem]">{r.dateLabel}</span>
                </div>
              </div>
            </div>
            <svg class="w-4 h-4 shrink-0 mt-0.5" viewBox="0 0 48 48" aria-label="Google review">
              <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20c11 0 20-8 20-20 0-1.3-.1-2.3-.4-3.5z"/>
              <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.1 18.9 12 24 12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
              <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35 26.7 36 24 36c-5.2 0-9.7-3.3-11.3-8l-6.5 5C9.4 39.6 16.1 44 24 44z"/>
              <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.2 5.6l6.2 5.2C41.4 35.5 44 30.2 44 24c0-1.3-.1-2.3-.4-3.5z"/>
            </svg>
          </header>
          <p class="text-ink-700 text-sm leading-relaxed line-clamp-5">{r.body}</p>
        </article>
      ))}
    </div>

    <!-- Stats bar -->
    <div class="border-t border-line pt-10 mb-10">
      <div class="flex flex-wrap items-end justify-center gap-x-16 gap-y-6">
        <div class="text-center">
          <p class="font-display text-3xl md:text-4xl text-ink-800 leading-none tabular-nums">5.0</p>
          <p class="text-xs text-ink-500 uppercase tracking-widest mt-2">Google Rating</p>
        </div>
        <div class="text-center">
          <p class="font-display text-3xl md:text-4xl text-brand-600 leading-none tabular-nums">25+</p>
          <p class="text-xs text-ink-500 uppercase tracking-widest mt-2">Years in St. Pete</p>
        </div>
        <div class="text-center">
          <p class="font-display text-3xl md:text-4xl text-ink-800 leading-none">In-House</p>
          <p class="text-xs text-ink-500 uppercase tracking-widest mt-2">Workroom Since 2000</p>
        </div>
      </div>
    </div>

    <!-- CTA + Google source attribution -->
    <div class="text-center">
      <a
        href={googleHref}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 bg-brand-500 hover:bg-brand-600 text-white font-semibold px-7 py-3.5 rounded shadow-sm transition tracking-wide uppercase text-sm"
        style="letter-spacing: 0.06em;"
      >
        Read Our Reviews on Google
        <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M7 17L17 7M8 7h9v9"/>
        </svg>
      </a>
      <p class="text-xs text-ink-400 mt-4 flex items-center justify-center gap-2">
        <svg class="w-4 h-4" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20c11 0 20-8 20-20 0-1.3-.1-2.3-.4-3.5z"/>
          <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.1 18.9 12 24 12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
          <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35 26.7 36 24 36c-5.2 0-9.7-3.3-11.3-8l-6.5 5C9.4 39.6 16.1 44 24 44z"/>
          <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.2 5.6l6.2 5.2C41.4 35.5 44 30.2 44 24c0-1.3-.1-2.3-.4-3.5z"/>
        </svg>
        Reviews sourced from Google
      </p>
    </div>
  </div>
</section>

<style>
  /* Stack carousel slides; only data-active="true" is visible.
     Display is toggled via JS, so non-active slides do not occupy space. */
  .review-slide { display: none; }
  .review-slide[data-active="true"] { display: block; }

  .review-dot { background-color: #d8cfb6; }
  .review-dot[data-active="true"] { background-color: var(--color-brand-500, #c19c3a); transform: scale(1.4); }

  .line-clamp-5 {
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  // Lightweight carousel: rotate every 7s, pause on hover, dots jump to slide.
  // One carousel per page; if multiple are added later, scope to each root.
  const root = document.querySelector<HTMLElement>('[data-review-carousel]');
  if (root) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.review-slide'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.review-dot'));
    let idx = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    const INTERVAL_MS = 7000;

    function paint(next: number) {
      slides.forEach((s, i) => s.setAttribute('data-active', i === next ? 'true' : 'false'));
      dots.forEach((d, i) => d.setAttribute('data-active', i === next ? 'true' : 'false'));
      idx = next;
    }

    function start() {
      stop();
      timer = setInterval(() => paint((idx + 1) % slides.length), INTERVAL_MS);
    }
    function stop() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    function go(delta: number) {
      paint((idx + delta + slides.length) % slides.length);
      start();
    }

    dots.forEach((d, i) => {
      d.addEventListener('click', () => { paint(i); start(); });
    });

    root.querySelector<HTMLButtonElement>('[data-review-prev]')?.addEventListener('click', () => go(-1));
    root.querySelector<HTMLButtonElement>('[data-review-next]')?.addEventListener('click', () => go(1));

    // Touch swipe (mobile): horizontal drag advances/reverses.
    let startX = 0;
    let tracking = false;
    root.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; tracking = true; }, { passive: true });
    root.addEventListener('touchend', (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
    }, { passive: true });

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);

    paint(0);
    if (slides.length > 1) start();
  }
</script>
