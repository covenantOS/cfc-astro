---
import { SITE, AREAS } from '~/lib/site';

interface Props {
  kind?: 'service' | 'area';
  currentSlug?: string;
}

const { kind = 'service', currentSlug } = Astro.props;

const SERVICE_GROUPS = [
  {
    label: 'Window Treatments',
    items: [
      { slug: 'custom-blinds', title: 'Custom Blinds' },
      { slug: 'window-shades', title: 'Window Shades' },
      { slug: 'plantation-shutters', title: 'Plantation Shutters' },
      { slug: 'outdoor-window-shades', title: 'Exterior Window Options' },
    ],
  },
  {
    label: 'Draperies & Curtains',
    items: [
      { slug: 'custom-draperies-curtains', title: 'Draperies & Curtains' },
      { slug: 'custom-cornices-valances', title: 'Cornices & Valances' },
      { slug: 'drapery-hardware', title: 'Drapery Hardware' },
    ],
  },
  {
    label: 'Interior Decor',
    items: [
      { slug: 'services-interior-decor-tampa', title: 'Interior Decor & Products' },
      { slug: 'custom-bedding-pillows', title: 'Bedding & Pillows' },
    ],
  },
  {
    label: 'Specialty',
    items: [
      { slug: 'furniture-reupholstery', title: 'Furniture Reupholstery' },
      { slug: 'custom-banquettes', title: 'Custom Banquettes' },
      { slug: 'commercial-window-treatments', title: 'Commercial Window Treatment' },
    ],
  },
];

const WHY_CHOOSE_US = [
  { title: '5-Star Rated', body: 'Dozens of 5-star Google reviews.' },
  { title: 'Master Craftsmanship', body: 'Flawless custom tailoring.' },
  { title: 'Designer Collections', body: 'Exclusive premium fabric selections.' },
  { title: 'Cohesive Styling', body: 'Perfectly matched interiors.' },
];
---

<aside class="lg:sticky lg:top-28 space-y-5 self-start">
  <!-- Get Your Free Estimate card -->
  <div class="bg-ink-900 text-white p-7 rounded-sm border border-brand-500/30 relative overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-1 bg-brand-500"></div>
    <h3 class="text-2xl text-white font-display mb-1">Get Your Free Estimate</h3>
    <p class="text-white/70 text-sm mb-5">Call us today or fill out the form below</p>
    <a href={SITE.phoneHref} class="flex items-center justify-center gap-2 bg-brand-500 hover:bg-brand-600 text-white font-semibold py-3.5 rounded-sm mb-3 tracking-wide">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
      </svg>
      {SITE.phone}
    </a>
    <a href="/contact/" class="block text-center bg-white/5 border border-white/40 hover:bg-white/15 text-white font-semibold py-3.5 rounded-sm text-sm tracking-wide uppercase" style="letter-spacing: 0.08em;">
      Schedule Consultation
    </a>
  </div>

  <!-- Services & Products (always shown) -->
  <div class="bg-white border border-line rounded-sm overflow-hidden">
    <div class="bg-cream-100 border-b border-line px-6 py-4">
      <h3 class="font-display text-lg text-ink-800">Services & Products</h3>
    </div>
    <div class="p-5 space-y-4">
      {SERVICE_GROUPS.map((group) => (
        <div>
          <h4 class="font-display text-ink-800 text-sm font-semibold mb-1.5 pb-1 border-b border-line/60">{group.label}</h4>
          <ul class="space-y-0.5">
            {group.items.map((item) => (
              <li>
                <a
                  href={`/services/${item.slug}/`}
                  class:list={[
                    'block text-sm pl-3 py-1.5 border-l-2 transition',
                    kind === 'service' && currentSlug === item.slug
                      ? 'border-brand-500 text-brand-700 font-semibold bg-cream-50'
                      : 'border-transparent text-ink-500 hover:border-brand-300 hover:text-brand-700 hover:bg-cream-50',
                  ]}
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <!-- Service Areas (always shown too) -->
  <div class="bg-white border border-line rounded-sm overflow-hidden">
    <div class="bg-cream-100 border-b border-line px-6 py-4">
      <h3 class="font-display text-lg text-ink-800">Service Areas</h3>
    </div>
    <ul class="p-4 grid grid-cols-2 gap-0.5">
      {AREAS.map((a) => (
        <li>
          <a
            href={`/areas/${a.slug}/`}
            class:list={[
              'block text-sm pl-3 py-1.5 border-l-2 transition',
              kind === 'area' && currentSlug === a.slug
                ? 'border-brand-500 text-brand-700 font-semibold bg-cream-50'
                : 'border-transparent text-ink-500 hover:border-brand-300 hover:text-brand-700 hover:bg-cream-50',
            ]}
          >
            {a.title}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Why Choose Us -->
  <div class="bg-white border border-line rounded-sm overflow-hidden">
    <div class="bg-cream-100 border-b border-line px-6 py-4">
      <h3 class="font-display text-lg text-ink-800">Why Choose Us</h3>
    </div>
    <ul class="p-6 space-y-4">
      {WHY_CHOOSE_US.map((item) => (
        <li class="flex items-start gap-3">
          <svg class="w-5 h-5 text-brand-500 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <div>
            <p class="font-semibold text-ink-800 text-sm">{item.title}</p>
            <p class="text-ink-500 text-xs">{item.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <!-- Google Review Widget -->
  <a href="https://www.google.com/search?q=custom+fabric+creations+st+petersburg" target="_blank" rel="noopener" class="block bg-white border border-line rounded-sm p-5 hover:border-brand-300 hover:shadow-card transition">
    <div class="flex items-center gap-3 mb-3 pb-3 border-b border-line">
      <svg class="w-10 h-10 shrink-0" viewBox="0 0 48 48" aria-hidden="true">
        <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20c11 0 20-8 20-20 0-1.3-.1-2.3-.4-3.5z"/>
        <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.1 18.9 12 24 12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
        <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35 26.7 36 24 36c-5.2 0-9.7-3.3-11.3-8l-6.5 5C9.4 39.6 16.1 44 24 44z"/>
        <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.2 5.6l6.2 5.2C41.4 35.5 44 30.2 44 24c0-1.3-.1-2.3-.4-3.5z"/>
      </svg>
      <div>
        <div class="flex items-center gap-0.5 text-[#FBBC04]" aria-hidden="true">
          {[1,2,3,4,5].map(() => (
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>
        <p class="font-bold text-ink-800 text-sm leading-tight">4.9 · Google Reviews</p>
      </div>
    </div>
    <div class="flex items-start gap-3">
      <div class="w-8 h-8 rounded-full bg-brand-500 text-white flex items-center justify-center text-xs font-bold shrink-0">JR</div>
      <div>
        <p class="text-xs text-ink-600 italic leading-relaxed">"The absolute best company I've ever worked with! Professional, honest, and reliable."</p>
        <p class="text-xs text-ink-400 mt-1">Jennifer R. · St. Pete</p>
      </div>
    </div>
  </a>
</aside>
