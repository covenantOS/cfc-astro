---
import { SITE, AREAS } from '~/lib/site';
import { getFeaturedReview } from '~/data/reviews';

const sidebarReview = getFeaturedReview();
const sidebarReviewBody = sidebarReview.body.length > 160
  ? sidebarReview.body.slice(0, 157).trimEnd() + '...'
  : sidebarReview.body;

interface Props {
  kind?: 'service' | 'area';
  currentSlug?: string;
  phone?: string;
  phoneHref?: string;
}

const {
  kind = 'service',
  currentSlug,
  phone = SITE.phone,
  phoneHref = SITE.phoneHref,
} = Astro.props;

const SERVICE_GROUPS = [
  {
    label: 'Window Treatments',
    items: [
      { slug: 'custom-blinds', title: 'Custom Blinds' },
      { slug: 'window-shades', title: 'Window Shades' },
      { slug: 'plantation-shutters', title: 'Plantation Shutters' },
      { slug: 'outdoor-window-shades', title: 'Exterior Window Options' },
    ],
  },
  {
    label: 'Draperies & Curtains',
    items: [
      { slug: 'custom-draperies-curtains', title: 'Draperies & Curtains' },
      { slug: 'custom-cornices-valances', title: 'Cornices & Valances' },
      { slug: 'drapery-hardware', title: 'Drapery Hardware' },
    ],
  },
  {
    label: 'Interior Decor',
    items: [
      { slug: 'services-interior-decor-tampa', title: 'Interior Decor & Products' },
      { slug: 'custom-bedding-pillows', title: 'Bedding & Pillows' },
    ],
  },
  {
    label: 'Specialty',
    items: [
      { slug: 'furniture-reupholstery', title: 'Furniture Reupholstery' },
      { slug: 'custom-banquettes', title: 'Custom Banquettes' },
      { slug: 'commercial-window-treatments', title: 'Commercial Window Treatment' },
    ],
  },
];

const WHY_CHOOSE_US = [
  { title: '5-Star Rated', body: 'Trusted by St. Pete homeowners.' },
  { title: 'Master Craftsmanship', body: 'Flawless custom tailoring.' },
  { title: 'Designer Collections', body: 'Exclusive premium fabric selections.' },
  { title: 'Cohesive Styling', body: 'Perfectly matched interiors.' },
];
---

<aside class="space-y-6">
  <!-- Get Your Free Estimate card -->
  <div class="bg-coffee-500 text-white p-8 rounded-lg border border-brand-500/30 relative overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-1 bg-brand-500"></div>
    <h3 class="text-2xl text-white font-display mb-1.5">Get Your Free Estimate</h3>
    <p class="text-white/80 text-sm mb-6">Call us today or schedule your consultation.</p>
    <a href={phoneHref} class="flex items-center justify-center gap-2.5 bg-brand-500 hover:bg-brand-600 text-white font-semibold py-4 rounded-md mb-3 text-base md:text-lg tracking-wide">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
      </svg>
      {phone}
    </a>
    <a href="/contact/" class="block text-center bg-white/10 border border-white/50 hover:bg-white/20 text-white font-semibold py-3.5 rounded-md text-sm tracking-wide uppercase" style="letter-spacing: 0.08em;">
      Schedule Consultation
    </a>
  </div>

  <!-- Services & Products - WCP-inspired: tight padding, full-width links, darker heading, instant hover -->
  <div class="bg-white rounded-lg shadow-card overflow-hidden">
    <div class="bg-coffee-100 border-b border-coffee-200 px-4 py-3.5">
      <h3 class="font-display text-base text-coffee-800 tracking-wide uppercase" style="letter-spacing: 0.08em;">Services &amp; Products</h3>
    </div>
    <div class="px-4 py-4 space-y-4">
      {SERVICE_GROUPS.map((group) => (
        <div>
          <h4 class="font-display text-ink-900 text-[0.7rem] tracking-[0.2em] uppercase font-bold mb-2 pb-1.5 border-b border-line">{group.label}</h4>
          <ul>
            {group.items.map((item) => (
              <li>
                <a
                  href={`/services/${item.slug}/`}
                  class:list={[
                    'block text-[0.92rem] px-3 py-2 border-l-2 transition-colors duration-100',
                    kind === 'service' && currentSlug === item.slug
                      ? 'border-brand-500 text-brand-700 font-semibold bg-cream-50'
                      : 'border-transparent text-ink-700 hover:border-brand-500 hover:text-brand-700 hover:bg-cream-50',
                  ]}
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <!-- Service Areas -->
  <div class="bg-white rounded-lg shadow-card overflow-hidden">
    <div class="bg-coffee-100 border-b border-coffee-200 px-4 py-3.5">
      <h3 class="font-display text-base text-coffee-800 tracking-wide uppercase" style="letter-spacing: 0.08em;">Service Areas</h3>
    </div>
    <ul class="px-4 py-3 grid grid-cols-2 gap-x-1">
      {AREAS.map((a) => (
        <li>
          <a
            href={`/areas/${a.slug}/`}
            class:list={[
              'block text-[0.88rem] px-2.5 py-1.5 border-l-2 transition-colors duration-100',
              kind === 'area' && currentSlug === a.slug
                ? 'border-brand-500 text-brand-700 font-semibold bg-cream-50'
                : 'border-transparent text-ink-700 hover:border-brand-500 hover:text-brand-700 hover:bg-cream-50',
            ]}
          >
            {a.title}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Why Choose Us -->
  <div class="bg-white rounded-lg shadow-card overflow-hidden">
    <div class="bg-coffee-100 border-b border-coffee-200 px-4 py-3.5">
      <h3 class="font-display text-base text-coffee-800 tracking-wide uppercase" style="letter-spacing: 0.08em;">Why Choose Us</h3>
    </div>
    <ul class="px-4 py-5 space-y-4">
      {WHY_CHOOSE_US.map((item) => (
        <li class="flex items-start gap-3">
          <svg class="w-4 h-4 text-brand-500 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <div>
            <p class="font-semibold text-ink-900 text-[0.92rem] leading-tight mb-0.5">{item.title}</p>
            <p class="text-ink-500 text-[0.8rem] leading-relaxed">{item.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <!-- Google Review Widget -->
  <a href="https://www.google.com/search?q=custom+fabric+creations+st+petersburg" target="_blank" rel="noopener" class="block bg-white rounded-lg shadow-card p-6 hover:border-brand-300 hover:shadow-card transition">
    <div class="flex items-center gap-3 mb-4 pb-4 border-b border-line">
      <svg class="w-10 h-10 shrink-0" viewBox="0 0 48 48" aria-hidden="true">
        <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20c11 0 20-8 20-20 0-1.3-.1-2.3-.4-3.5z"/>
        <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.1 18.9 12 24 12c3.1 0 5.9 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
        <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35 26.7 36 24 36c-5.2 0-9.7-3.3-11.3-8l-6.5 5C9.4 39.6 16.1 44 24 44z"/>
        <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.2 5.6l6.2 5.2C41.4 35.5 44 30.2 44 24c0-1.3-.1-2.3-.4-3.5z"/>
      </svg>
      <div>
        <div class="flex items-center gap-0.5 text-[#FBBC04]" aria-hidden="true">
          {[1,2,3,4,5].map(() => (
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>
        <p class="font-bold text-ink-800 text-sm leading-tight">5.0 on Google</p>
      </div>
    </div>
    <div class="flex items-start gap-3">
      {sidebarReview.avatar ? (
        <img
          src={sidebarReview.avatar}
          alt=""
          class="w-8 h-8 rounded-full object-cover shrink-0"
          width="32"
          height="32"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div
          class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold shrink-0"
          style={`background-color: ${sidebarReview.avatarColor};`}
          aria-hidden="true"
        >{sidebarReview.initials}</div>
      )}
      <div>
        <p class="text-xs text-ink-600 italic leading-relaxed">"{sidebarReviewBody}"</p>
        <p class="text-xs text-ink-400 mt-1">{sidebarReview.name}</p>
      </div>
    </div>
  </a>
</aside>

<style is:global>
  /* The sidebar's grid-cell wrapper (in ServiceLayout/AreaLayout) is the
     sticky, independently-scrolling element now. This styles its scrollbar.
     Sticky + scroll live on `.sidebar-scroll`; the aside itself is a plain
     block so it can travel the full content height as you scroll. */
  @media (min-width: 1024px) {
    .sidebar-scroll {
      padding-right: 0.25rem;
      scrollbar-gutter: stable;
    }
    .sidebar-scroll::-webkit-scrollbar { width: 6px; }
    .sidebar-scroll::-webkit-scrollbar-thumb { background: #d8cfb6; border-radius: 3px; }
    .sidebar-scroll::-webkit-scrollbar-thumb:hover { background: #bca050; }
  }
</style>
