---
// "Expert tip from Terry": cream card, gold left rule, gold lightbulb +
// eyebrow at the top. The tip body runs full width, and the portrait +
// attribution sit in a footer row. This avoids the squished narrow text
// column the side-by-side layout produced on mobile.
//
// Voice rules: see project-cfc-voice-sheet memory. Warm, plainspoken,
// no em dashes, no marketing verbs. Tips A and B are the calibration
// anchors.
//
// When the real Terry photo arrives, drop it at
// /public/images/team/terry.webp and pass portrait="/images/team/terry.webp".

interface Props {
  body: string;
  eyebrow?: string;
  name?: string;
  role?: string;
  portrait?: string;
  monogram?: string;
}

const {
  body,
  eyebrow = 'Expert tip from Terry',
  name = 'Terry',
  role = 'Owner, Custom Fabric Creations',
  portrait,
  monogram = 'T',
} = Astro.props;
---

<aside class="my-10 not-prose">
  <div class="bg-cream-50 border-l-4 border-brand-500 rounded-r-lg shadow-card">
    <div class="p-5 md:p-7">

      <div class="flex items-center gap-2 mb-3">
        <svg class="w-4 h-4 text-brand-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M9 18h6"/>
          <path d="M10 22h4"/>
          <path d="M2 9a7 7 0 0 1 14 0c0 2.4-1.5 4.1-3 5.5V17h-8v-2.5C3.5 13.1 2 11.4 2 9z"/>
        </svg>
        <p
          class="font-display text-xs uppercase m-0"
          style="letter-spacing: 0.22em; color: var(--color-brand-700);"
        >{eyebrow}</p>
      </div>

      <p class="leading-relaxed text-[1rem] md:text-lg mb-5" style="color: var(--color-ink-700);">
        {body}
      </p>

      <div class="flex items-center gap-3 pt-4 border-t border-brand-500/20">
        {portrait ? (
          <img
            src={portrait}
            alt={`${name}, ${role}`}
            class="w-11 h-11 rounded-full object-cover shrink-0 ring-2 ring-brand-500/40"
            width="44"
            height="44"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div
            class="w-11 h-11 rounded-full flex items-center justify-center shrink-0 font-display text-xl"
            style="background-color: var(--color-cream-200); color: var(--color-brand-700); border: 1px solid var(--color-brand-500);"
            aria-hidden="true"
          >{monogram}</div>
        )}
        <p class="text-sm" style="color: var(--color-ink-500);">
          <span class="font-bold" style="color: var(--color-ink-800);">{name}</span>
          <span> · {role}</span>
        </p>
      </div>
    </div>
  </div>
</aside>
