---
// "Expert tip from Terry": Titan-style expert tip callout, adapted to CFC
// palette. Light cream bg, gold left border (4px), lightbulb icon next to
// the gold eyebrow, circular owner portrait with a gold ring on the left,
// tip body in her warm voice, owner name and role at the bottom.
//
// Voice rules for `body`: see project-cfc-voice-sheet memory. Warm,
// plainspoken, customer-agency framing, no em dashes, no marketing verbs.
// 40 to 70 words. Original Tip A and Tip B from 2026-05-20 are the
// calibration anchors.
//
// When the real Terry photo is delivered, drop it at
// /public/images/team/terry.webp and pass portrait="/images/team/terry.webp".
// Until then the monogram circle stands in.

interface Props {
  body: string;
  eyebrow?: string;
  name?: string;
  role?: string;
  portrait?: string;
  monogram?: string;
}

const {
  body,
  eyebrow = 'Expert tip from Terry',
  name = 'Terry',
  role = 'Owner, Custom Fabric Creations',
  portrait,
  monogram = 'T',
} = Astro.props;
---

<aside class="my-12 md:my-14 not-prose">
  <div class="bg-cream-50 border-l-4 border-brand-500 rounded-r-lg shadow-card overflow-hidden">
    <div class="p-6 md:p-8">

      <div class="flex items-center gap-2 mb-5">
        <svg class="w-4 h-4 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M9 18h6"/>
          <path d="M10 22h4"/>
          <path d="M2 9a7 7 0 0 1 14 0c0 2.4-1.5 4.1-3 5.5V17h-8v-2.5C3.5 13.1 2 11.4 2 9z"/>
        </svg>
        <p class="eyebrow text-brand-700 m-0" style="letter-spacing: 0.25em;">{eyebrow}</p>
      </div>

      <div class="grid gap-5 md:grid-cols-[88px_1fr] md:gap-7 items-start">

        {portrait ? (
          <img
            src={portrait}
            alt={`${name}, ${role}`}
            class="w-20 h-20 md:w-22 md:h-22 rounded-full object-cover shrink-0 ring-4 ring-brand-500/40"
            width="88"
            height="88"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div
            class="w-20 h-20 md:w-22 md:h-22 rounded-full flex items-center justify-center shrink-0 ring-4 ring-brand-500/40 bg-ink-900 text-brand-400 font-display text-4xl"
            aria-hidden="true"
          >{monogram}</div>
        )}

        <div>
          <blockquote class="text-ink-700 leading-relaxed text-base md:text-lg mb-4">
            {body}
          </blockquote>
          <p class="text-sm">
            <span class="font-bold text-ink-800">{name}</span>
            <span class="text-ink-500"> · {role}</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</aside>
