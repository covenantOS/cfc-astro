---
import { AREAS, SITE } from '~/lib/site';

interface Props {
  heading?: string;
  eyebrow?: string;
  subtitle?: string;
  /** Section background — choose so it alternates with surrounding sections.
   *  White section gets cream tiles, cream section gets white tiles. */
  background?: 'white' | 'cream';
}

const {
  heading = 'St. Pete & Pinellas Neighborhoods We Serve',
  eyebrow = 'Our service area',
  subtitle = 'Based in St. Petersburg, we bring the studio to homes across Pinellas County. Click any neighborhood to see local examples and book a complimentary in-home consultation.',
  background = 'cream',
} = Astro.props;

const sectionBg = background === 'cream' ? 'bg-cream-50' : 'bg-white';
const tileBg = background === 'cream' ? 'bg-white' : 'bg-cream-50';
---

<section class={`py-20 md:py-28 ${sectionBg}`}>
  <div class="container-site">
    <div class="text-center max-w-2xl mx-auto mb-12 md:mb-14">
      {eyebrow && <p class="eyebrow" style="letter-spacing: 0.3em;">{eyebrow}</p>}
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl text-ink-800 leading-tight mb-5">{heading}</h2>
      {subtitle && <p class="text-ink-500 leading-relaxed">{subtitle}</p>}
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
      {AREAS.map((a) => (
        <a
          href={`/areas/${a.slug}/`}
          class={`group block ${tileBg} rounded-lg shadow-card p-5 md:p-6 transition duration-200 hover:bg-ink-900 hover:shadow-card-hover hover:-translate-y-0.5`}
        >
          <p class="font-display font-bold text-ink-800 group-hover:text-white text-base md:text-lg leading-tight transition-colors">
            {a.title}
          </p>
          <p class="text-ink-400 group-hover:text-brand-300 text-xs md:text-sm mt-1 transition-colors">
            {a.descriptor}
          </p>
        </a>
      ))}
    </div>

    <p class="text-center mt-8 text-sm text-ink-500">
      Don't see your ZIP code?
      <a href={SITE.phoneHref} class="ml-1 inline-flex items-center gap-1 font-bold text-brand-700 hover:text-brand-600 transition">
        Call {SITE.phone}
        <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 10h10M11 5l5 5-5 5"/></svg>
      </a>
      <span class="block sm:inline sm:ml-1">— we still serve all of Tampa Bay.</span>
    </p>
  </div>
</section>
