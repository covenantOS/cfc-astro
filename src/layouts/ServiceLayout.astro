---
import BaseLayout from './BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import ServiceSidebar from '~/components/ServiceSidebar.astro';
import GlobalContactMap from '~/components/GlobalContactMap.astro';
import FAQ from '~/components/FAQ.astro';
import FinalCTA from '~/components/FinalCTA.astro';
import { SITE } from '~/lib/site';

interface Props {
  title: string;
  description: string;
  serviceSlug: string;
  serviceTitle: string;
  heroImage?: string;
  heroTitle?: string;
  heroSubtitle?: string;
  heroEyebrow?: string;
  heroBullets?: string[];
  heroShowRating?: boolean;
  heroTrustBar?: boolean;
  faqs?: Array<{ q: string; a: string }>;
}

const {
  title,
  description,
  serviceSlug,
  serviceTitle,
  heroImage,
  heroTitle,
  heroSubtitle,
  heroEyebrow,
  heroBullets,
  heroShowRating,
  heroTrustBar,
  faqs,
} = Astro.props;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services/' },
  { name: serviceTitle, url: `/services/${serviceSlug}/` },
];
---

<BaseLayout
  title={title}
  description={description}
  pageType="service"
  breadcrumbs={breadcrumbs}
  serviceSlug={serviceSlug}
  serviceTitle={serviceTitle}
  faqs={faqs}
  ogImage={heroImage ?? `/images/hero/${serviceSlug}.webp`}
>
  <Hero
    title={heroTitle ?? `${serviceTitle} in St. Petersburg, FL`}
    subtitle={heroSubtitle ?? description}
    image={heroImage ?? `/images/hero/${serviceSlug}.webp`}
    eyebrow={heroEyebrow}
    bullets={heroBullets}
    showRating={heroShowRating}
    trustBar={heroTrustBar}
    primaryCta={{ label: SITE.phone, href: SITE.phoneHref }}
    secondaryCta={{ label: 'Schedule Consultation', href: '/contact/' }}
    breadcrumbs={breadcrumbs}
    goldLine
  />

  <section class="py-16 md:py-20 bg-white">
    <div class="container-site grid gap-10 lg:grid-cols-[380px_1fr] lg:gap-16 items-start">
      <article class="prose-cfc content-card min-w-0 lg:col-start-2 lg:row-start-1">
        <slot />
      </article>
      <div class="lg:col-start-1 lg:row-start-1 lg:sticky lg:top-28 lg:self-start lg:max-h-[calc(100dvh-7rem)] lg:overflow-y-auto sidebar-scroll">
        <ServiceSidebar kind="service" currentSlug={serviceSlug} />
      </div>
    </div>
  </section>

  {faqs && faqs.length > 0 && (
    <FAQ items={faqs} heading={`${serviceTitle}, Frequently Asked Questions`} eyebrow="Common Questions" subtitle={`Answers about our ${serviceTitle.toLowerCase()} process.`} />
  )}

  <GlobalContactMap />
</BaseLayout>
