---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import StickyMobileCTA from '~/components/StickyMobileCTA.astro';
import Schema from '~/components/Schema.astro';
import { SITE } from '~/lib/site';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  pageType?: 'home' | 'service' | 'area' | 'article' | 'contact' | 'about' | 'gallery' | 'brands' | 'collection' | 'page';
  breadcrumbs?: Array<{ name: string; url: string }>;
  serviceSlug?: string;
  serviceTitle?: string;
  areaSlug?: string;
  areaTitle?: string;
  articleDate?: string;
  faqs?: Array<{ q: string; a: string }>;
  hideMobileCta?: boolean;
}

const {
  title,
  description = SITE.description,
  canonical,
  ogImage = '/images/hero/homepage.webp',
  noindex = false,
  pageType = 'page',
  breadcrumbs,
  serviceSlug,
  serviceTitle,
  areaSlug,
  areaTitle,
  articleDate,
  faqs,
  hideMobileCta = false,
} = Astro.props;

// Append " | Custom Fabric Creations" only when it still fits under 60c.
// Otherwise use the page title as-is — we already include brand signals in copy.
const BRAND_SUFFIX = ` | ${SITE.name}`;
const fullTitle = title === SITE.name
  ? `${SITE.name} | St. Pete Window Treatments`
  : title.length + BRAND_SUFFIX.length <= 60
    ? `${title}${BRAND_SUFFIX}`
    : title;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).toString();
const ogImageUrl = new URL(ogImage, SITE.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#333333" />
    <meta name="facebook-domain-verification" content="a40pl8os7cpbgw9yd0aphm760d8t7y" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex
      ? <meta name="robots" content="noindex,nofollow" />
      : <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1" />
    }

    <meta property="og:type" content={pageType === 'article' ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/xml" title="Sitemap" href="/sitemap.xml" />

    <!-- Pre-warm Google Maps origins so the lazy-loaded embed paints fast
         the moment it scrolls into view. Used on contact, service, and
         area pages — almost every route. -->
    <link rel="preconnect" href="https://www.google.com" crossorigin />
    <link rel="preconnect" href="https://maps.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://maps.googleapis.com" />

    <Schema
      pageType={pageType}
      title={fullTitle}
      description={description}
      canonicalUrl={canonicalUrl}
      breadcrumbs={breadcrumbs}
      serviceSlug={serviceSlug}
      serviceTitle={serviceTitle}
      areaSlug={areaSlug}
      areaTitle={areaTitle}
      articleDate={articleDate}
      faqs={faqs}
      image={ogImage}
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    {!hideMobileCta && <StickyMobileCTA />}
  </body>
</html>
