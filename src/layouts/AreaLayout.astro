---
import BaseLayout from './BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import ServiceSidebar from '~/components/ServiceSidebar.astro';
import GlobalContactMap from '~/components/GlobalContactMap.astro';
import ServiceGrid from '~/components/ServiceGrid.astro';
import FAQ from '~/components/FAQ.astro';
import { getLocationForArea } from '~/lib/site';

interface Props {
  title: string;
  description: string;
  areaSlug: string;
  areaTitle: string;
  heroImage?: string;
  heroTitle?: string;
  heroSubtitle?: string;
  faqs?: Array<{ q: string; a: string }>;
}

const {
  title,
  description,
  areaSlug,
  areaTitle,
  heroImage,
  heroTitle,
  heroSubtitle,
  faqs,
} = Astro.props;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Areas', url: '/areas/' },
  { name: areaTitle, url: `/areas/${areaSlug}/` },
];

// West St. Pete area uses its own tracking number; everything else uses Central.
const location = getLocationForArea(areaSlug);
---

<BaseLayout
  title={title}
  description={description}
  pageType="area"
  breadcrumbs={breadcrumbs}
  areaSlug={areaSlug}
  areaTitle={areaTitle}
  faqs={faqs}
  ogImage={heroImage ?? `/images/areas/${areaSlug}.webp`}
>
  <Hero
    title={heroTitle ?? `Custom Window Treatments & Upholstery in ${areaTitle}`}
    subtitle={heroSubtitle ?? description}
    image={heroImage ?? `/images/areas/${areaSlug}.webp`}
    primaryCta={{ label: location.phone, href: location.phoneHref }}
    secondaryCta={{ label: 'Schedule Consultation', href: '/contact/' }}
    breadcrumbs={breadcrumbs}
    goldLine
  />

  <section class="py-16 md:py-20 bg-cream-50">
    <div class="container-site grid gap-10 lg:grid-cols-[380px_1fr] lg:gap-16 items-start">
      <article class="prose-cfc content-card min-w-0 lg:col-start-2 lg:row-start-1">
        <slot />
      </article>
      <div class="lg:col-start-1 lg:row-start-1">
        <ServiceSidebar kind="area" currentSlug={areaSlug} phone={location.phone} phoneHref={location.phoneHref} />
      </div>
    </div>
  </section>

  <ServiceGrid
    eyebrow="What we offer"
    heading={`Services available in ${areaTitle}`}
    limit={6}
  />

  {faqs && faqs.length > 0 && (
    <FAQ items={faqs} heading={`${areaTitle}: Frequently Asked Questions`} eyebrow="Common Questions" subtitle={`Answers about our services in ${areaTitle}.`} />
  )}

  <GlobalContactMap areaLabel={`Serving ${areaTitle} & the St. Pete coast`} phone={location.phone} phoneHref={location.phoneHref} />
</BaseLayout>
