---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import FinalCTA from '~/components/FinalCTA.astro';

const GALLERY = [
  { img: '/images/gallery/master-suite-gallery.webp', title: 'Master Suite', body: 'A luxury bedroom with custom velvet upholstery, coordinated soft furnishings, and tailored linen draperies.' },
  { img: '/images/gallery/custom-drapery-gallery.webp', title: 'Patterned Drapery', body: 'Floor to ceiling geometric pattern drapes on modern hardware for expansive corner windows balancing natural light and privacy.' },
  { img: '/images/gallery/lanai-shading-gallery.webp', title: 'Lanai Shading', body: 'Integrated window shading and coordinating cushion upholstery for a premium year-round covered patio space.' },
  { img: '/images/gallery/contrast-drapery-gallery.webp', title: 'Contrast Drapery', body: 'Bold contrast-banded drapery panels that frame the view while adding dimension and formal architectural scale.' },
  { img: '/images/gallery/custom-valances-gallery.webp', title: 'Custom Valances', body: 'Upholstered cornices and soft valances tailored to window proportion, echoing trim colors and room accents.' },
  { img: '/images/gallery/panel-tracks-gallery.webp', title: 'Panel Tracks', body: 'Modern panel track systems that disappear when open and deliver crisp light control on oversized sliders.' },
  { img: '/images/gallery/roller-shades-gallery.webp', title: 'Roller Shades', body: 'Designer solar and blackout roller shades engineered for Florida sun, motorized where the opening calls for it.' },
  { img: '/images/gallery/woven-shades-gallery.webp', title: 'Woven Wood Shades', body: 'Natural woven wood shades add warmth and texture to sun-drenched rooms without heavy visual weight.' },
  { img: '/images/gallery/custom-upholstery-gallery.webp', title: 'Custom Upholstery', body: 'Frame-up reupholstery with designer textiles from Kravet and Stout, restoring heirloom pieces and custom builds.' },
  { img: '/images/services/plantation-shutters/top.webp', title: 'Plantation Shutters', body: 'Custom faux-wood plantation shutters fitted to the exact window opening, built to hold up to Gulf sun and humidity.' },
  { img: '/images/services/custom-cornices-valances/top.webp', title: 'Cornices & Valances', body: 'Board-mounted cornices and soft valances that finish the top of the window and tie the room together.' },
  { img: '/images/services/furniture-reupholstery/top.webp', title: 'Reupholstered Seating', body: 'A tired frame brought back to life with fresh padding and a durable performance fabric chosen for daily use.' },
  { img: '/images/services/services-interior-decor-tampa/top.webp', title: 'Interior Styling', body: 'Coordinated fabrics, hardware, and finishing touches pulled together during an in-home design consultation.' },
  { img: '/images/services/drapery-hardware/top.webp', title: 'Drapery Hardware', body: 'Decorative rods, concealed tracks, and finials selected to match the home and carry the weight of full panels.' },
  { img: '/images/services/custom-bedding-pillows/bottom.webp', title: 'Custom Bedding & Pillows', body: 'Tailored bedding and accent pillows in coordinated textiles that complete a finished master suite.' },
  { img: '/images/new/window-treatment3.webp', title: 'Floor-to-Ceiling Drapery', body: 'Dramatic floor-to-ceiling drapery that frames tall windows and adds height and softness to the room.' },
  { img: '/images/new/custom-window-treatments.webp', title: 'Custom Window Treatments', body: 'Full-length custom window treatments designed around the room light and proportions.' },
  { img: '/images/new/custom-window-treatments-geometric-pattern.webp', title: 'Geometric Pattern Treatments', body: 'Bold geometric-pattern window treatments that add scale and personality to a light-filled room.' },
  { img: '/images/new/custom-curtains-and-drapery.webp', title: 'Custom Curtains & Drapery', body: 'Floor-length custom curtains sewn to the exact window for a clean break at the floor.' },
  { img: '/images/new/custom-curtains.webp', title: 'Custom Curtains', body: 'Custom-sewn curtains tailored to the window height and hardware for a polished hang.' },
  { img: '/images/new/custom-mauve-drapery-on-gold-hardware.webp', title: 'Mauve Drapery on Gold Hardware', body: 'Soft mauve drapery panels on warm gold rods, tailored to the window for a refined, layered look.' },
  { img: '/images/new/modern-blackout-drapes-nailhead-trim-custom-fabrics.webp', title: 'Nailhead-Trim Blackout Drapes', body: 'Modern blackout drapery finished with nailhead trim in a custom designer fabric for full light control.' },
  { img: '/images/new/custom-drapes-leather-armchairs-cow-art.webp', title: 'Drapery with Leather Seating', body: 'Tailored drapery framing a sitting area with leather armchairs, coordinated as one considered design.' },
  { img: '/images/new/custom-sliding-glass-door-window-treatments.webp', title: 'Sliding Glass Door Treatments', body: 'Custom treatments sized for a wide sliding glass door, balancing privacy, light, and easy operation.' },
  { img: '/images/new/integrated-drapery-and-shades-open-plan-living.webp', title: 'Layered Drapery & Shades', body: 'Integrated drapery over shades in an open-plan living space for daytime light and evening privacy.' },
  { img: '/images/new/integrated-shades-and-drapery-system.webp', title: 'Shade & Drapery System', body: 'A coordinated shade-and-drapery system that manages glare and softness on a bright living-room window.' },
  { img: '/images/new/window-shades.webp', title: 'Custom Window Shades', body: 'Designer window shades that cut Florida glare while keeping the view through the fabric.' },
  { img: '/images/new/custom-blinds.webp', title: 'Custom Blinds', body: 'Made-to-measure blinds fitted to the exact opening for clean lines and even light control.' },
  { img: '/images/new/custom-blinds-and-window-shades.webp', title: 'Blinds & Shades', body: 'Custom blinds paired with shades for layered light control across a run of windows.' },
  { img: '/images/new/outdoor-window-shades.webp', title: 'Outdoor Window Shades', body: 'Exterior shades that tame sun and heat on a lanai while keeping the outdoor view.' },
  { img: '/images/new/cornices-and-valances.webp', title: 'Cornices & Valances', body: 'Board-mounted cornices and soft valances that finish the top of the window and hide the hardware.' },
  { img: '/images/new/navy-blue-valance-geometric-drapery-panels.webp', title: 'Navy Valance & Geometric Panels', body: 'A navy upholstered valance over geometric-patterned drapery panels for a tailored, formal window.' },
  { img: '/images/new/custom-banquettes.webp', title: 'Custom Banquette Seating', body: 'A built-in banquette upholstered in performance fabric, turning a corner into comfortable seating.' },
  { img: '/images/new/furniture-reupholstery.webp', title: 'Furniture Reupholstery', body: 'A frame brought back to life with new padding and a durable designer performance fabric.' },
  { img: '/images/new/custom-bedding.webp', title: 'Custom Bedding', body: 'Tailored bedding in designer fabric, sized to the bed and coordinated with the room.' },
  { img: '/images/new/custom-bedding-and-pillows.webp', title: 'Bedding & Pillows', body: 'Coordinated custom bedding and throw pillows that complete a finished bedroom.' },
  { img: '/images/new/custom-bedding-and-pillows-master-bedroom.webp', title: 'Master Bedroom Bedding', body: 'Custom bedding and accent pillows that pull a master bedroom together in coordinated designer textiles.' },
  { img: '/images/new/commercial-window-treatments.webp', title: 'Commercial Window Treatments', body: 'Durable, brand-consistent window treatments outfitted for a commercial interior.' },
  { img: '/images/new/commercial-window-curtains.webp', title: 'Commercial Drapery', body: 'Contract-grade drapery for a commercial space, built for constant use and a finished look.' },
  { img: '/images/new/interior-consultation-design.webp', title: 'Interior Design Consultation', body: 'Fabrics, hardware, and finishes pulled together during an in-home design consultation.' },
  { img: '/images/new/interior-decor-consultation.webp', title: 'Interior Decor Consultation', body: 'An in-home decor consultation matching soft goods to the existing finishes of the home.' },
  { img: '/images/new/interior-curtains.webp', title: 'Interior Curtains', body: 'Soft interior curtains that warm a room and filter bright afternoon light.' },
  { img: '/images/new/window-treatments-big-window.webp', title: 'Treatments for Large Windows', body: 'Large-format window treatments scaled to oversized glass without overwhelming the room.' },
];
---

<BaseLayout
  title="Gallery"
  description="Explore completed custom window treatment, drapery, plantation shutter, and master upholstery projects by Custom Fabric Creations, our St. Petersburg workroom's designer textiles and precise in-house installation across Pinellas County."
  pageType="gallery"
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Gallery', url: '/gallery/' }]}
>
  <Hero
    eyebrow="Design Portfolio"
    title="Bespoke Interior Transformations."
    subtitle="Review our completed custom window treatment and master upholstery projects. Explore how our dedicated local workroom elevates luxury living spaces across the St. Pete coast with flawless tailoring and exclusive designer materials."
    image="/images/hero/homepage.webp"
    primaryCta={{ label: 'Schedule Consultation', href: '/contact/' }}
    breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Gallery', url: '/gallery/' }]}
    goldLine
  />

  <section class="py-16 md:py-20 bg-white">
    <div class="container-site max-w-6xl mx-auto">
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {GALLERY.map((item) => (
          <figure class="group bg-white overflow-hidden rounded-lg shadow-card hover:shadow-card-hover transition">
            <div class="aspect-[4/3] overflow-hidden bg-ink-50">
              <img
                src={item.img}
                alt={`${item.title}, ${item.body} By Custom Fabric Creations, St. Petersburg, FL.`}
                title={`${item.title} | Custom Fabric Creations, bespoke window treatments & upholstery in St. Petersburg, FL`}
                class="w-full h-full object-cover group-hover:scale-[1.03] transition duration-700"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="p-6">
              <h3 class="font-display text-xl text-ink-800 mb-2">{item.title}</h3>
              <p class="text-sm text-ink-500 leading-relaxed">{item.body}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <FinalCTA
    heading="Want This in Your Home?"
    subtitle="Every piece in this gallery started with a complimentary in-home consultation."
    secondary={{ label: 'See Our Services', href: '/services/' }}
  />
</BaseLayout>
