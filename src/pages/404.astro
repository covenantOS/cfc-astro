---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="Sorry, we can’t find that page." noindex>
  <section class="py-32 md:py-40 bg-linen">
    <div class="container-narrow text-center">
      <p class="eyebrow">404</p>
      <h1 class="font-display text-5xl md:text-6xl text-ink-800 title-rule">Page not found.</h1>
      <p class="mt-8 text-lg text-ink-500 max-w-xl mx-auto">
        The page you’re looking for may have been moved or no longer exists.
      </p>
      <div class="mt-10 cta-group">
        <a href="/" class="btn-primary btn-lg">Return home</a>
        <a href="/services/" class="btn-ghost btn-lg">Browse services</a>
      </div>
    </div>
  </section>
</BaseLayout>
