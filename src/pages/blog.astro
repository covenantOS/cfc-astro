---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import AboutSection from '~/components/AboutSection.astro';
import GalleryPreview from '~/components/GalleryPreview.astro';
import DualLocationTrust from '~/components/DualLocationTrust.astro';
import GlobalContactMap from '~/components/GlobalContactMap.astro';
import ReviewSection from '~/components/ReviewSection.astro';
import FinalCTA from '~/components/FinalCTA.astro';

// Blog / resources index. Lists the site's long-form guides and articles.
// Standalone article pages live under src/pages/*.astro; when a new one is
// added, add an entry here (newest first) so it appears in the listing.

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
];

const POSTS = [
  {
    title: 'Custom Drapery in St. Petersburg, FL: The 2026 Guide',
    excerpt: 'Pricing, our 5-step workroom process, the designer fabric library (Kravet, Stout, Lee Jofa), and what to know before you order custom drapery in Pinellas County.',
    href: '/custom-drapery-st-petersburg/',
    image: '/images/hero/custom-draperies-curtains.webp',
    dateISO: '2026-05-11',
    dateLabel: 'May 2026',
    category: 'Drapery',
  },
  {
    title: 'Why Some Homeowners Regret Plantation Shutters (And How to Avoid It)',
    excerpt: 'The real downsides of plantation shutters, light blocking, dusting, cost, and lead time, and how to decide if they are right for your St. Petersburg home.',
    href: '/plantation-shutters-regret-downsides/',
    image: '/images/hero/plantation-shutters.webp',
    dateISO: '2026-04-15',
    dateLabel: 'Apr 2026',
    category: 'Plantation Shutters',
  },
  {
    title: 'Plantation Shutter Installation in St. Petersburg: What Actually Happens',
    excerpt: 'A step-by-step look at what plantation shutter installation involves in a St. Pete home, from measurement to finish, by a local installer.',
    href: '/plantation-shutters-installation-st-petersburg/',
    image: '/images/hero/plantation-shutters.webp',
    dateISO: '2026-04-10',
    dateLabel: 'Apr 2026',
    category: 'Plantation Shutters',
  },
  {
    title: 'Plantation Shutters Cost in St. Petersburg, FL: Real 2026 Pricing',
    excerpt: 'What plantation shutters actually cost in St. Pete in 2026, real price ranges by material (faux wood vs. basswood), window size, brand, and installation.',
    href: '/plantation-shutters-cost-st-petersburg/',
    image: '/images/hero/plantation-shutters.webp',
    dateISO: '2026-04-01',
    dateLabel: 'Apr 2026',
    category: 'Plantation Shutters',
  },
];
---

<BaseLayout
  title="Blog & Window Treatment Guides | St. Petersburg, FL"
  description="Guides and articles on custom window treatments in St. Petersburg, FL: plantation shutter cost and installation, custom drapery, and how to choose the right treatment for your home."
  pageType="collection"
  ogImage="/images/hero/homepage.webp"
  breadcrumbs={breadcrumbs}
>
  <Hero
    eyebrow="Guides & Resources"
    title="The Custom Fabric Creations Blog"
    subtitle="Honest, local guides on custom window treatments in St. Petersburg, from pricing and installation to choosing what fits your home."
    image="/images/hero/homepage.webp"
    primaryCta={{ label: 'Schedule Consultation', href: '/contact/' }}
    breadcrumbs={breadcrumbs}
    goldLine
  />

  <section class="py-16 md:py-24 bg-white">
    <div class="container-site">
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {POSTS.map((post) => (
          <article class="group flex flex-col surface-card surface-card-hover overflow-hidden">
            <a href={post.href} class="block aspect-[16/10] overflow-hidden">
              <img
                src={post.image}
                alt={post.title}
                title={post.title}
                class="w-full h-full object-cover transition duration-500 group-hover:scale-[1.04]"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="flex flex-col flex-1 p-6">
              <div class="flex items-center gap-3 mb-3 text-xs">
                <span class="inline-flex items-center px-2.5 py-1 rounded-sm bg-brand-50 text-brand-800 font-semibold uppercase tracking-wider">{post.category}</span>
                <time datetime={post.dateISO} class="text-ink-400">{post.dateLabel}</time>
              </div>
              <h2 class="font-display text-xl text-ink-800 leading-snug mb-3">
                <a href={post.href} class="hover:text-brand-700 transition">{post.title}</a>
              </h2>
              <p class="text-ink-500 text-sm leading-relaxed mb-5 flex-1">{post.excerpt}</p>
              <a href={post.href} class="inline-flex items-center gap-1 text-brand-700 font-semibold text-sm hover:text-brand-800 transition">
                Read article
                <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 10h10M11 5l5 5-5 5"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <AboutSection />

  <GalleryPreview />

  <section class="py-16 md:py-20 bg-cream-50">
    <div class="container-site">
      <div class="text-center max-w-2xl mx-auto mb-2">
        <p class="eyebrow" style="letter-spacing: 0.3em;">Where to Find Us</p>
        <h2 class="font-display text-3xl md:text-4xl text-ink-800 leading-tight">Two Google profiles, one local team</h2>
      </div>
      <DualLocationTrust heading="Serving St. Petersburg, with a studio in West St. Pete" />
    </div>
  </section>

  <GlobalContactMap />

  <ReviewSection />

  <FinalCTA />
</BaseLayout>
