---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/lib/site';
---

<BaseLayout
  title="Thank You"
  description="Thank you for reaching out to Custom Fabric Creations."
  noindex
>
  <section class="py-32 md:py-40 bg-linen">
    <div class="container-narrow text-center">
      <p class="eyebrow">Message received</p>
      <h1 class="font-display text-5xl md:text-6xl text-ink-800 title-rule">Thank you.</h1>
      <p class="mt-8 text-lg text-ink-500 leading-relaxed max-w-xl mx-auto">
        A member of our studio will be in touch within one business day. For urgent requests, please call us directly.
      </p>
      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <a href={SITE.phoneHref} class="btn-primary btn-lg">{SITE.phone}</a>
        <a href="/" class="btn-ghost btn-lg">Return home</a>
      </div>
    </div>
  </section>
</BaseLayout>
