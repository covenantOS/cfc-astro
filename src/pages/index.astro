---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import ServiceGrid from '~/components/ServiceGrid.astro';
import AboutSection from '~/components/AboutSection.astro';
import AreasMap from '~/components/AreasMap.astro';
import BrandStrip from '~/components/BrandStrip.astro';
import FAQ from '~/components/FAQ.astro';
import FinalCTA from '~/components/FinalCTA.astro';
import ReviewSection from '~/components/ReviewSection.astro';
import InfoFeatureCards from '~/components/InfoFeatureCards.astro';
import ImageCTA from '~/components/ImageCTA.astro';
import { SITE } from '~/lib/site';
---

<BaseLayout
  title={SITE.name}
  description="St. Pete's premier studio for bespoke window treatments, drapery, shutters, and upholstery. 25+ years of craftsmanship. Free consultations."
  pageType="home"
  ogImage="/images/hero/homepage.webp"
>
  <Hero
    eyebrow="St. Pete Premier Design Studio"
    title="Custom Window Treatments and Bespoke Upholstery"
    subtitle="Elevate your home with handcrafted draperies, premium <a href='/services/plantation-shutters/' class='underline decoration-brand-400 hover:text-brand-300'>plantation shutters</a>, and master upholstery. We bring our curated sample library directly to your living room with personalized design."
    video="/hero-video.mp4"
    image="/images/hero/homepage.webp"
    bullets={['Drapery Hardware', 'Custom Treatments', 'Shades & Blinds']}
    primaryCta={{ label: 'Schedule Consultation', href: '/contact/' }}
    secondaryCta={{ label: `Call ${SITE.phone}`, href: SITE.phoneHref }}
    showRating
    trustBar
    size="tall"
    bend
    bendColor="#fcf7e3"
  />

  <ServiceGrid />

  <AboutSection />

  <InfoFeatureCards />

  <AreasMap />

  <ImageCTA />

  <BrandStrip />

  <ReviewSection />

  <FAQ />

  <FinalCTA />
</BaseLayout>
