---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import FinalCTA from '~/components/FinalCTA.astro';

const BRANDS = [
  {
    name: 'Hunter Douglas',
    tagline: 'The gold standard in window fashions',
    body: 'Hunter Douglas is the most recognized name in custom window treatments for a reason. We’re an authorized dealer for their full line — Silhouette sheers, Duette cellular shades, Pirouette, Vignette roman shades, PowerView motorization, and NewStyle plantation shutters. Lifetime limited warranty on every product.',
    highlights: ['Silhouette & Vignette shades', 'Duette honeycomb / cellular', 'NewStyle & Heritance shutters', 'PowerView motorization'],
  },
  {
    name: 'Norman',
    tagline: 'Workhorse plantation shutters for Florida',
    body: 'Norman’s Woodlore line is our most-installed plantation shutter in St. Pete homes. Florida-tough faux wood that resists humidity, UV, and temperature swings without warping. Their Wavz line covers real basswood for interior rooms. Lifetime warranty, factory-direct pricing, rapid turnaround.',
    highlights: ['Woodlore & Woodlore Plus faux wood', 'Normandy real basswood', 'SmartFit motorized shades', 'Lifetime limited warranty'],
  },
  {
    name: 'Graber',
    tagline: 'Exceptional shades and blinds',
    body: 'Graber offers one of the broadest window treatment catalogs in the industry — roller shades, roman shades, cellular, pleated, wood blinds, woven woods, natural shades, and motorized systems. Mid-range pricing, excellent build quality, fast lead times. A favorite for budget-conscious projects that don’t want to compromise on fit.',
    highlights: ['Roller, Roman & cellular shades', 'Real wood & faux wood blinds', 'Woven wood natural shades', 'Motorized options across lines'],
  },
  {
    name: 'Kravet',
    tagline: 'Designer fabric house',
    body: 'Kravet is the designer’s choice for custom drapery, upholstery, and bedding fabrics. Thousands of patterns across every category — velvets, linens, embroidered silks, indoor-outdoor performance fabrics, leather, and specialty textiles. We’re an authorized workroom, so you get trade pricing passed through.',
    highlights: ['Signature fabric collections', 'Lee Jofa, Brunschwig & Fils, GP & J Baker', 'Crypton performance fabrics', 'Indoor-outdoor collections'],
  },
  {
    name: 'Stout',
    tagline: 'Distinctive textiles and trims',
    body: 'Stout specializes in distinctive, character-driven fabrics — woven jacquards, textured solids, bold patterns, and exceptional trims. Their indoor-outdoor performance lines are standout. A favorite for clients who want custom drapery that doesn’t look like everyone else’s.',
    highlights: ['Signature patterns and solids', 'Performance & Sunbrella-compatible', 'Decorative trims and tapes', 'Exclusive designer collaborations'],
  },
];
---

<BaseLayout
  title="Brands We Carry — Hunter Douglas, Norman, Graber, Kravet"
  description="Authorized dealer for Hunter Douglas, Norman, Graber, Kravet, and Stout. Premium window treatments and designer fabrics in St. Petersburg, FL."
  pageType="brands"
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Brands', url: '/brands/' }]}
>
  <Hero
    eyebrow="Authorized Dealer"
    title="The Brands Designers Trust."
    subtitle="We partner with the most respected window fashion and textile houses — so you get designer-grade quality, paired with local craftsmanship and hands-on service."
    image="/images/hero/homepage.webp"
    breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Brands', url: '/brands/' }]}
    goldLine
  />

  <section class="py-20 md:py-28 bg-white">
    <div class="container-site max-w-5xl mx-auto">
      <div class="space-y-16">
        {BRANDS.map((b, i) => (
          <div class:list={['grid md:grid-cols-[220px_1fr] gap-10 items-start', i !== BRANDS.length - 1 && 'pb-16 border-b border-line']}>
            <div>
              <p class="eyebrow">{b.tagline}</p>
              <h2 class="font-display text-3xl text-ink-800 mb-0">{b.name}</h2>
            </div>
            <div>
              <p class="text-ink-600 text-[1.05rem] leading-relaxed mb-6">{b.body}</p>
              <ul class="grid sm:grid-cols-2 gap-3">
                {b.highlights.map((h) => (
                  <li class="flex items-start gap-2 text-sm text-ink-700">
                    <svg class="w-5 h-5 text-brand-500 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M5 10l3 3 7-7"/>
                    </svg>
                    {h}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FinalCTA
    heading="Find the Right Product for Your Home"
    subtitle="Not sure which brand or product fits your project? We’ll walk every window with you during your in-home consultation."
  />
</BaseLayout>
