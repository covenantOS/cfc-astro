---
import { getCollection, render } from 'astro:content';
import ServiceLayout from '~/layouts/ServiceLayout.astro';
import OwnerTip from '~/components/OwnerTip.astro';
import InlineReview from '~/components/InlineReview.astro';
import FeatureList from '~/components/FeatureList.astro';
import RelatedLink from '~/components/RelatedLink.astro';
import ByNumbersBanner from '~/components/ByNumbersBanner.astro';
import { SERVICES } from '~/lib/site';
import { getServiceExtras } from '~/data/service-extras';

export async function getStaticPaths() {
  const entries = await getCollection('services');
  return SERVICES.map((service) => {
    const entry = entries.find((e) => e.data.slug === service.slug);
    return {
      params: { slug: service.slug },
      props: { service, entry },
    };
  });
}

const { service, entry } = Astro.props;

const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content ?? null;
const data = entry?.data;
const serviceTitle = service.title;
const displayTitle = data?.title ?? `${serviceTitle} in St. Petersburg, FL`;
const description = data?.description ?? `${serviceTitle} services in St. Petersburg, FL.`;
const heroTitle = data?.h1 ?? `${serviceTitle} in St. Petersburg, FL`;
const faqs = data?.faqs ?? [];

// Per-service content add-ons. Only services configured in
// src/data/service-extras.ts render these (rolling out one service at a
// time before broad rollout).
const extras = getServiceExtras(service.slug);
---

<ServiceLayout
  title={displayTitle}
  description={description}
  serviceSlug={service.slug}
  serviceTitle={serviceTitle}
  heroTitle={heroTitle}
  heroSubtitle={description}
  heroImage={data?.heroImage ?? `/images/hero/${service.slug}.webp`}
  heroEyebrow={data?.heroEyebrow}
  heroBullets={data?.heroBullets}
  heroShowRating={data?.heroShowRating}
  heroTrustBar={data?.heroTrustBar}
  faqs={faqs}
>
  {extras?.tip && (
    <OwnerTip
      body={extras.tip.body}
      eyebrow={extras.tip.eyebrow}
      name={extras.tip.name}
      role={extras.tip.role}
      portrait={extras.tip.portrait}
    />
  )}

  {extras?.featureList && (
    <FeatureList items={extras.featureList.items} columns={extras.featureList.columns} />
  )}

  {Content ? <Content /> : <p>Content coming soon.</p>}

  {extras?.relatedLink && (
    <RelatedLink
      body={extras.relatedLink.body}
      href={extras.relatedLink.href}
      linkText={extras.relatedLink.linkText}
    />
  )}

  {extras?.reviewTag && (
    <InlineReview tag={extras.reviewTag} label={extras.reviewLabel} />
  )}

  {extras?.closingBanner && (
    <ByNumbersBanner
      eyebrow={extras.closingBanner.eyebrow}
      statement={extras.closingBanner.statement}
    />
  )}
</ServiceLayout>
