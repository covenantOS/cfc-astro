---
import ServiceLayout from '~/layouts/ServiceLayout.astro';
import { SERVICES } from '~/lib/site';

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const INTROS: Record<string, string> = {
  'custom-draperies-curtains': 'Hand-crafted drapery and curtains, cut and sewn in our St. Pete workroom. From full-length pinch-pleat panels to sheer layered treatments, every drape is measured and finished to your windows.',
  'plantation-shutters': 'Plantation shutters built for Florida light and humidity. Hunter Douglas and Norman shutters, precision-measured and installed by our own team.',
  'window-shades': 'Roman, cellular, roller, woven wood, and motorized shades \u2014 the full range of window shades, measured and installed in-home.',
  'custom-blinds': 'Custom blinds in wood, faux wood, aluminum, and vertical styles. Designed for privacy, light control, and long-term durability.',
  'custom-cornices-valances': 'Upholstered cornices and soft valances that add architecture and softness to a room. Built in our workroom to your measurements.',
  'drapery-hardware': 'Custom drapery rods, rings, finials, and brackets \u2014 decorative and functional hardware sourced from the industry\u2019s best.',
  'outdoor-window-shades': 'Exterior window shades and solar screens built for Florida sun, wind, and rain. Protect your lanai and your furniture.',
  'furniture-reupholstery': 'Bring a cherished chair, sofa, or bench back to life. Frame-up reupholstery with fabrics from Kravet, Stout, and more.',
  'custom-bedding-pillows': 'Custom headboards, bed skirts, duvets, shams, and throw pillows. Bedding that finishes the room.',
  'custom-banquettes': 'Built-in banquette seating for dining nooks and kitchens. Cushions, backs, and details designed to last.',
  'commercial-window-treatments': 'Window treatments for hotels, restaurants, medical offices, and commercial properties across St. Pete.',
  'services-interior-decor-tampa': 'Interior decor consultation \u2014 we help you develop a cohesive design direction, room by room.',
};

const intro = INTROS[service.slug] ?? 'Bespoke craftsmanship from our St. Petersburg studio.';
---

<ServiceLayout
  title={service.title}
  description={intro}
  heroSubtitle={intro}
>
  <p class="text-xl text-ink-500 leading-relaxed mb-10">
    <em>[Placeholder \u2014 port full service copy from the live site.]</em>
  </p>
  <h2>What to expect</h2>
  <p>Every project begins with a complimentary in-home consultation. We measure, show fabrics and finishes in your space, and provide a written estimate.</p>
  <h2>Our craftsmanship</h2>
  <p>Every piece is cut and sewn in our St. Petersburg workroom \u2014 no outsourcing. Our installation team handles the final fit and finish.</p>
  <h2>Ready to start?</h2>
  <p>Call <a href="tel:+17272404512">(727) 240-4512</a> or <a href="/contact/">schedule a consultation online</a>.</p>
</ServiceLayout>
