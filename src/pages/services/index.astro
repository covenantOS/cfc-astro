---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import ServiceGrid from '~/components/ServiceGrid.astro';
import FinalCTA from '~/components/FinalCTA.astro';
---

<BaseLayout
  title="Our Services"
  description="Custom drapery, plantation shutters, shades, blinds, wallpaper, cornices, furniture reupholstery, custom bedding, and commercial window treatments from Custom Fabric Creations in St. Petersburg."
  pageType="collection"
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Services', url: '/services/' }]}
>
  <Hero
    eyebrow="A Full Studio of Services"
    title="Custom Window Treatments, Upholstery, and More."
    subtitle="Every service is measured, crafted, and installed by our own team. No middlemen. No outsourced workrooms."
    image="/images/hero/homepage.webp"
    primaryCta={{ label: 'Schedule Consultation', href: '/contact/' }}
    breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Services', url: '/services/' }]}
    goldLine
  />

  <ServiceGrid heading="All Services" eyebrow="Explore" subtitle={undefined} />

  <FinalCTA />
</BaseLayout>
