---
import { getCollection, render } from 'astro:content';
import AreaLayout from '~/layouts/AreaLayout.astro';
import { AREAS } from '~/lib/site';

export async function getStaticPaths() {
  // The two main areas (St. Petersburg Central and West St. Pete) have their
  // own dedicated landing pages, so exclude them here to avoid route collisions.
  const LANDING_PAGE_SLUGS = ['st-petersburg', 'west-st-pete'];
  const entries = await getCollection('areas');
  return AREAS.filter((area) => !LANDING_PAGE_SLUGS.includes(area.slug)).map((area) => {
    const entry = entries.find((e) => e.data.slug === area.slug);
    return {
      params: { slug: area.slug },
      props: { area, entry },
    };
  });
}

const { area, entry } = Astro.props;

const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content ?? null;
const data = entry?.data;
const areaTitle = area.title;
const displayTitle = data?.title ?? `${areaTitle} Window Treatments & Upholstery`;
const description = data?.description ?? `Window treatments and upholstery in ${areaTitle}.`;
const heroTitle = data?.h1 ?? `Custom Window Treatments in ${areaTitle}`;
const faqs = data?.faqs ?? [];
---

<AreaLayout
  title={displayTitle}
  description={description}
  areaSlug={area.slug}
  areaTitle={areaTitle}
  heroTitle={heroTitle}
  heroSubtitle={description}
  heroImage={`/images/areas/${area.slug}.webp`}
  faqs={faqs}
>
  {Content ? <Content /> : <p>Content coming soon.</p>}
</AreaLayout>
