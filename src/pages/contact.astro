---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import ReviewSection from '~/components/ReviewSection.astro';
import { SITE, AREAS } from '~/lib/site';

// Public Maps JS key. Restrict by HTTP referrer in Google Cloud Console;
// the key ships to the browser regardless. Override via env var if rotated.
const GOOGLE_MAPS_API_KEY =
  import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY ||
  'AIzaSyBUJIKu-1Mz89rsF9sDUQrobzM-rNa1COw';
---

<BaseLayout
  title="Schedule Your Design Consultation"
  description="Schedule a complimentary in-home design consultation with Custom Fabric Creations. We bring our full fabric library, hardware samples, and 25+ years of expertise to your home. Serving St. Petersburg and Pinellas County. Call (727) 240-4512."
  pageType="contact"
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact/' }]}
>
  <Hero
    eyebrow="Client Support and Scheduling"
    title="Schedule Your Design"
    titleAccent="Consultation"
    subtitle="Tell us about your space. We'll bring the showroom to you — fabrics, finishes, and hardware, all in your home, in your natural light."
    image="/images/hero/homepage.webp"
    breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact/' }]}
    primaryCta={{ label: `Call ${SITE.phone}`, href: SITE.phoneHref }}
    goldLine
  >
    <div slot="aside" class="bg-white rounded-lg shadow-card p-5 sm:p-7 md:p-8 max-w-md mx-auto lg:mx-0 lg:ml-auto">
      <h3 class="font-display text-xl sm:text-2xl text-ink-800 mb-1">Get Your Free Estimate</h3>
      <p class="text-ink-500 text-sm mb-5">A real person follows up within one business day.</p>

      <div class="grid grid-cols-2 gap-3 mb-5">
        <button type="button" class="space-option group relative text-left p-3 rounded-lg bg-cream-50 transition" data-space="residential" aria-pressed="true">
          <span class="space-check absolute top-2.5 right-2.5 w-4 h-4 rounded-full bg-brand-500 text-white flex items-center justify-center opacity-0 transition">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5L20 7"/></svg>
          </span>
          <div class="w-9 h-9 rounded-full bg-ink-900 text-brand-400 flex items-center justify-center mb-2">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12l9-9 9 9M5 10v10h14V10"/></svg>
          </div>
          <p class="font-bold text-ink-800 text-sm leading-tight">Residential</p>
          <p class="text-xs text-ink-500 mt-0.5">Home or condo</p>
        </button>
        <button type="button" class="space-option group relative text-left p-3 rounded-lg bg-cream-50 transition" data-space="commercial" aria-pressed="false">
          <span class="space-check absolute top-2.5 right-2.5 w-4 h-4 rounded-full bg-brand-500 text-white flex items-center justify-center opacity-0 transition">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5L20 7"/></svg>
          </span>
          <div class="w-9 h-9 rounded-full bg-ink-900 text-brand-400 flex items-center justify-center mb-2">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="1"/><path d="M4 12h16M12 4v16"/></svg>
          </div>
          <p class="font-bold text-ink-800 text-sm leading-tight">Commercial</p>
          <p class="text-xs text-ink-500 mt-0.5">Office or retail</p>
        </button>
      </div>

      <form method="POST" action="/api/contact/" class="space-y-3" autocomplete="on">
        <input type="hidden" id="space" name="space" value="residential"/>
        <div class="grid sm:grid-cols-2 gap-3">
          <input name="name" required placeholder="Your name *" autocomplete="name" class="w-full border border-line bg-white px-4 py-3 rounded-md focus:outline-none focus:border-brand-500" />
          <input name="phone" required type="tel" placeholder="Phone *" autocomplete="tel" class="w-full border border-line bg-white px-4 py-3 rounded-md focus:outline-none focus:border-brand-500" />
        </div>
        <input name="email" required type="email" placeholder="Email *" autocomplete="email" class="w-full border border-line bg-white px-4 py-3 rounded-md focus:outline-none focus:border-brand-500" />
        <div id="street-mount" class="space-y-0">
          <input id="street-input" name="street" placeholder="Street address" autocomplete="street-address" class="w-full border border-line bg-white px-4 py-3 rounded-md focus:outline-none focus:border-brand-500" />
        </div>
        <input id="city-input" name="area" placeholder="City" autocomplete="address-level2" class="w-full border border-line bg-white px-4 py-3 rounded-md focus:outline-none focus:border-brand-500" />
        <textarea name="message" rows="3" placeholder="Tell us about your project..." autocomplete="off" class="w-full border border-line bg-white px-4 py-3 rounded-md focus:outline-none focus:border-brand-500"></textarea>
        <button type="submit" class="btn-primary btn-lg w-full">Request Consultation</button>
      </form>
    </div>
  </Hero>

  <!-- Compact info strip — replaces the duplicate "Schedule Your Consultation"
       section so the hero now carries that message. Phone, hours, and service
       area sit as a clean 3-up row that reads cleanly on mobile too. -->
  <section class="py-10 md:py-14 bg-white">
    <div class="container-site max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8">
      <a href={SITE.phoneHref} class="flex items-center gap-4 p-4 rounded-lg hover:bg-cream-50 transition">
        <span class="icon-badge shrink-0">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
        </span>
        <div>
          <p class="text-ink-500 text-xs uppercase tracking-widest mb-0.5">Phone</p>
          <p class="text-ink-800 font-bold">{SITE.phone}</p>
        </div>
      </a>
      <div class="flex items-center gap-4 p-4">
        <span class="icon-badge shrink-0">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        </span>
        <div>
          <p class="text-ink-500 text-xs uppercase tracking-widest mb-0.5">Hours</p>
          <p class="text-ink-800 font-bold">Mon–Sat 7am–7pm</p>
        </div>
      </div>
      <div class="flex items-center gap-4 p-4">
        <span class="icon-badge shrink-0">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </span>
        <div>
          <p class="text-ink-500 text-xs uppercase tracking-widest mb-0.5">Service area</p>
          <p class="text-ink-800 font-bold">St. Pete & Pinellas</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16 md:py-24 bg-cream-50">
    <div class="container-site max-w-6xl mx-auto grid gap-8 lg:gap-10 lg:grid-cols-2 items-start">
      <div class="min-w-0">
        <p class="eyebrow" style="letter-spacing: 0.3em;">Local Service Areas</p>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl text-ink-800 leading-tight mb-6">Serving St. Petersburg and Pinellas County</h2>
        <p class="text-ink-500 leading-relaxed mb-8">Select your specific community below to check your eligibility for a complimentary in-home design consultation.</p>
        <ul class="grid sm:grid-cols-2 gap-y-3 gap-x-6">
          {AREAS.map((a) => (
            <li>
              <a href={`/areas/${a.slug}/`} class="inline-flex items-center gap-2 text-brand-600 hover:text-brand-800 transition font-medium">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                {a.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="min-w-0 aspect-[4/3] overflow-hidden rounded-lg shadow-soft">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d56271.82398378395!2d-82.70485474755367!3d27.771192729988576!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88c2e2c3a4e5b8bf%3A0xe50e91b2dabe2c34!2sSt.%20Petersburg%2C%20FL!5e0!3m2!1sen!2sus!4v1700000000000"
          width="100%" height="100%" style="border:0;" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
          title="Custom Fabric Creations service area map"></iframe>
      </div>
    </div>
  </section>

  <ReviewSection />
</BaseLayout>

<style>
  .space-option {
    border: 2px solid var(--color-line, #e5e0d3);
    box-shadow: none;
  }
  .space-option:hover {
    border-color: #bca050;
  }
  .space-option[aria-pressed='true'] {
    border-color: #bca050;
    background-color: #faf3df;
    box-shadow: 0 0 0 2px rgba(188, 160, 80, 0.25);
  }
  .space-option[aria-pressed='true'] .space-check {
    opacity: 1;
  }

  /* Match Google's PlaceAutocompleteElement to the rest of the form.
     The element ships with a dark Material theme; force light scheme and
     override the internal input + dropdown via every selector that works. */
  gmp-place-autocomplete {
    display: block;
    width: 100%;
    color-scheme: light;
    background: #ffffff;
    color: #1a1a1a;
    border: 1px solid var(--color-line, #e5e0d3);
    border-radius: 0.125rem;
    font-family: inherit;
    font-size: 1rem;
    --gmpx-color-surface: #ffffff;
    --gmpx-color-on-surface: #1a1a1a;
    --gmpx-color-on-surface-variant: #6b6b6b;
    --gmpx-color-primary: #bca050;
    --gmpx-color-outline: #e5e0d3;
    --gmpx-font-family-base: inherit;
    --gmpx-font-size-base: 1rem;
  }
  gmp-place-autocomplete:focus-within {
    border-color: #bca050;
  }
  gmp-place-autocomplete input {
    background: #ffffff !important;
    color: #1a1a1a !important;
    border: 0 !important;
    padding: 0.75rem 1rem !important;
    font-family: inherit !important;
    font-size: 1rem !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }
  gmp-place-autocomplete::part(input),
  gmp-place-autocomplete::part(prediction-item),
  gmp-place-autocomplete::part(prediction-list) {
    background: #ffffff;
    color: #1a1a1a;
  }
</style>

<script>
  document.querySelectorAll('button[data-space]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('button[data-space]').forEach(function (b) {
        b.setAttribute('aria-pressed', 'false');
      });
      btn.setAttribute('aria-pressed', 'true');
      var input = document.getElementById('space');
      if (input) input.value = btn.getAttribute('data-space') || 'residential';
    });
  });
</script>

<script is:inline define:vars={{ GOOGLE_MAPS_API_KEY }}>
  // Places Autocomplete using PlaceAutocompleteElement (Places API New).
  // Docs: https://developers.google.com/maps/documentation/javascript/place-autocomplete-new
  (function () {
    if (!GOOGLE_MAPS_API_KEY) return;

    // If Google's loader fails (bad key, referrer block, billing off, etc.)
    // the plain street input stays in place so users can still type by hand.
    window.gm_authFailure = function () {
      console.warn('Google Maps authFailure — falling back to plain input');
    };

    async function initPlaces() {
      var mount = document.getElementById('street-mount');
      var fallbackInput = document.getElementById('street-input');
      var cityInput = document.getElementById('city-input');
      if (!mount || !window.google || !window.google.maps) return;

      try {
        var places = await window.google.maps.importLibrary('places');
        var PlaceAutocompleteElement = places.PlaceAutocompleteElement;
        if (!PlaceAutocompleteElement) return;

        var ac = new PlaceAutocompleteElement({
          includedRegionCodes: ['us'],
          types: ['address'],
        });
        // Carry over name + placeholder so the form payload still includes "street"
        ac.name = 'street';
        ac.id = 'street-input';
        ac.setAttribute('placeholder', 'Street address');

        // Replace the plain input with the live web component.
        if (fallbackInput) fallbackInput.remove();
        mount.appendChild(ac);

        ac.addEventListener('gmp-select', async function (ev) {
          try {
            var place = ev.placePrediction.toPlace();
            await place.fetchFields({ fields: ['addressComponents', 'formattedAddress'] });

            var streetNumber = '';
            var route = '';
            var city = '';
            (place.addressComponents || []).forEach(function (c) {
              var types = c.types || [];
              if (types.indexOf('street_number') !== -1) streetNumber = c.longText || c.shortText;
              else if (types.indexOf('route') !== -1) route = c.longText || c.shortText;
              else if (types.indexOf('locality') !== -1) city = c.longText || c.shortText;
              else if (!city && types.indexOf('postal_town') !== -1) city = c.longText || c.shortText;
              else if (!city && types.indexOf('sublocality') !== -1) city = c.longText || c.shortText;
            });

            var streetLine = (streetNumber + ' ' + route).trim() || place.formattedAddress || '';
            if (streetLine) ac.value = streetLine;
            if (city && cityInput && !cityInput.value) cityInput.value = city;
          } catch (err) {
            console.warn('Place fetch failed:', err);
          }
        });
      } catch (err) {
        console.warn('Places autocomplete unavailable:', err);
      }
    }

    window.__cfcInitPlaces = initPlaces;
    var s = document.createElement('script');
    s.src =
      'https://maps.googleapis.com/maps/api/js?key=' +
      encodeURIComponent(GOOGLE_MAPS_API_KEY) +
      '&libraries=places&v=weekly&loading=async&callback=__cfcInitPlaces';
    s.async = true;
    s.defer = true;
    document.head.appendChild(s);
  })();
</script>
