---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import GlobalContactMap from '~/components/GlobalContactMap.astro';
import { SITE } from '~/lib/site';
---

<BaseLayout
  title="Schedule Your Design Consultation"
  description="Schedule a complimentary in-home consultation with Custom Fabric Creations. Serving St. Petersburg and Pinellas County. Call (727) 240-4512."
  pageType="contact"
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact/' }]}
>
  <Hero
    eyebrow="Let\u2019s Begin"
    title="Schedule Your Consultation."
    subtitle="Tell us about your space. We\u2019ll bring the showroom to you \u2014 fabrics, finishes, and hardware, all in your home, in your natural light."
    image="/images/hero/homepage.webp"
    breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact/' }]}
  />

  <section class="py-20 md:py-28 bg-white">
    <div class="container-site grid gap-14 lg:grid-cols-2 max-w-6xl mx-auto">
      <div>
        <p class="eyebrow">Get in Touch</p>
        <h2 class="font-display text-3xl md:text-4xl text-ink-800 mb-8 title-rule-left">Three Ways to Start</h2>

        <div class="space-y-8 text-ink-600">
          <div>
            <p class="text-xs tracking-widest uppercase text-brand-600 font-semibold mb-1">1. Call us</p>
            <a href={SITE.phoneHref} class="font-display text-3xl text-ink-800 hover:text-brand-700 block mb-1">{SITE.phone}</a>
            <p class="text-sm">Monday\u2013Saturday, 9:00am\u20135:00pm</p>
          </div>

          <div>
            <p class="text-xs tracking-widest uppercase text-brand-600 font-semibold mb-1">2. Email</p>
            <a href={`mailto:${SITE.email}`} class="text-lg text-ink-700 hover:text-brand-700 block">{SITE.email}</a>
            <p class="text-sm mt-1">We respond within one business day.</p>
          </div>

          <div>
            <p class="text-xs tracking-widest uppercase text-brand-600 font-semibold mb-1">3. Use the form</p>
            <p>Tell us a little about your project and we\u2019ll reach out to schedule your in-home consultation.</p>
          </div>
        </div>

        <div class="mt-10 p-6 bg-cream border-l-4 border-brand-500">
          <h3 class="font-display text-xl text-ink-800 mb-2">Service Area</h3>
          <p class="text-ink-600 text-sm leading-relaxed">
            We serve St. Petersburg, Clearwater, and all surrounding Pinellas County neighborhoods. Free in-home consultations included. If you\u2019re just outside our stated service area, call us \u2014 we often travel for the right project.
          </p>
        </div>
      </div>

      <form
        id="contact-form"
        class="bg-cream p-8 md:p-10 rounded-sm border border-line"
        method="POST"
        action="/api/contact/"
      >
        <h2 class="font-display text-2xl text-ink-800 mb-6">Request Your Consultation</h2>
        <div class="grid gap-5">
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-semibold text-ink-700 mb-2">Name *</label>
              <input id="name" name="name" required type="text" class="w-full border border-line bg-white px-4 py-3 rounded-sm focus:outline-none focus:border-brand-500" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-semibold text-ink-700 mb-2">Phone *</label>
              <input id="phone" name="phone" required type="tel" class="w-full border border-line bg-white px-4 py-3 rounded-sm focus:outline-none focus:border-brand-500" />
            </div>
          </div>
          <div>
            <label for="email" class="block text-sm font-semibold text-ink-700 mb-2">Email *</label>
            <input id="email" name="email" required type="email" class="w-full border border-line bg-white px-4 py-3 rounded-sm focus:outline-none focus:border-brand-500" />
          </div>
          <div>
            <label for="area" class="block text-sm font-semibold text-ink-700 mb-2">Neighborhood / City</label>
            <input id="area" name="area" type="text" placeholder="e.g. Snell Isle, St. Pete Beach" class="w-full border border-line bg-white px-4 py-3 rounded-sm focus:outline-none focus:border-brand-500" />
          </div>
          <div>
            <label for="service" class="block text-sm font-semibold text-ink-700 mb-2">What are you interested in?</label>
            <select id="service" name="service" class="w-full border border-line bg-white px-4 py-3 rounded-sm focus:outline-none focus:border-brand-500">
              <option value="">Select a service</option>
              <option>Custom Drapery & Curtains</option>
              <option>Plantation Shutters</option>
              <option>Window Shades</option>
              <option>Custom Blinds</option>
              <option>Furniture Reupholstery</option>
              <option>Custom Bedding & Pillows</option>
              <option>Commercial Window Treatments</option>
              <option>Other / Multiple</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-semibold text-ink-700 mb-2">Tell us about your project</label>
            <textarea id="message" name="message" rows="5" placeholder="Windows, rooms, style direction, timeline..." class="w-full border border-line bg-white px-4 py-3 rounded-sm focus:outline-none focus:border-brand-500"></textarea>
          </div>
          <button type="submit" class="btn-primary btn-lg w-full mt-2">Request Consultation</button>
          <p class="text-xs text-ink-500 text-center">We respond within one business day.</p>
        </div>
      </form>
    </div>
  </section>

  <GlobalContactMap
    heading="Visit Us in St. Pete"
    subtitle="Our workroom is based in St. Petersburg. Most consultations happen in your home \u2014 we bring samples, finishes, and hardware to you."
    areaLabel="Serving all of Pinellas County"
  />
</BaseLayout>
