---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import { SITE, AREAS } from '~/lib/site';
---

<BaseLayout
  title="Schedule Your Design Consultation"
  description="Schedule a complimentary in-home consultation with Custom Fabric Creations. Serving St. Petersburg and Pinellas County. Call (727) 240-4512."
  pageType="contact"
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact/' }]}
>
  <Hero
    eyebrow="Client Support and Scheduling"
    title="Schedule Your Design Consultation"
    subtitle="Tell us about your space. We'll bring the showroom to you — fabrics, finishes, and hardware, all in your home, in your natural light."
    image="/images/hero/homepage.webp"
    breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact/' }]}
    bend
  />

  <section class="py-16 md:py-24 bg-white">
    <div class="container-site max-w-6xl mx-auto grid gap-10 lg:grid-cols-2 items-start">
      <div>
        <p class="eyebrow" style="letter-spacing: 0.3em;">Client Support and Scheduling</p>
        <h2 class="font-display text-4xl md:text-5xl text-ink-800 leading-tight mb-6">Schedule Your Design Consultation</h2>
        <ul class="space-y-2 text-ink-600 text-lg mb-8 leading-relaxed">
          <li>- Request a consultation or call us directly.</li>
          <li>- We bring our material library to your living space.</li>
          <li>- Our team handles the complete final installation.</li>
        </ul>
        <a href={SITE.phoneHref} class="inline-flex items-center gap-2 bg-brand-500 hover:bg-brand-600 text-white font-semibold px-7 py-3.5 rounded-sm transition">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
          </svg>
          Call {SITE.phone}
        </a>
      </div>

      <div class="bg-cream-50 border border-line rounded-sm p-8 md:p-10 shadow-soft">
        <h3 class="font-display text-2xl text-ink-800 mb-6">What type of space are we designing?</h3>
        <div class="grid grid-cols-2 gap-4 mb-8">
          <button type="button" class="group text-left p-5 border border-line rounded-sm bg-white hover:border-brand-500 transition" data-space="residential">
            <div class="w-10 h-10 rounded-sm bg-brand-50 text-brand-700 flex items-center justify-center mb-3">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12l9-9 9 9M5 10v10h14V10"/></svg>
            </div>
            <p class="font-semibold text-ink-800 mb-1">Residential</p>
            <p class="text-xs text-ink-500">Home, condo, or townhouse</p>
          </button>
          <button type="button" class="group text-left p-5 border border-line rounded-sm bg-white hover:border-brand-500 transition" data-space="commercial">
            <div class="w-10 h-10 rounded-sm bg-brand-50 text-brand-700 flex items-center justify-center mb-3">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="1"/><path d="M4 12h16M12 4v16"/></svg>
            </div>
            <p class="font-semibold text-ink-800 mb-1">Commercial</p>
            <p class="text-xs text-ink-500">Office, retail, or hospitality</p>
          </button>
        </div>

        <form method="POST" action="/api/contact/" class="space-y-4">
          <input type="hidden" id="space" name="space" value="residential"/>
          <div class="grid sm:grid-cols-2 gap-4">
            <input name="name" required placeholder="Your name *" class="w-full border border-line bg-white px-4 py-3 rounded-sm focus:outline-none focus:border-brand-500" />
            <input name="phone" required type="tel" placeholder="Phone *" class="w-full border border-line bg-white px-4 py-3 rounded-sm focus:outline-none focus:border-brand-500" />
          </div>
          <input name="email" required type="email" placeholder="Email *" class="w-full border border-line bg-white px-4 py-3 rounded-sm focus:outline-none focus:border-brand-500" />
          <input name="area" placeholder="Neighborhood or city" class="w-full border border-line bg-white px-4 py-3 rounded-sm focus:outline-none focus:border-brand-500" />
          <textarea name="message" rows="4" placeholder="Tell us about your project..." class="w-full border border-line bg-white px-4 py-3 rounded-sm focus:outline-none focus:border-brand-500"></textarea>
          <button type="submit" class="btn-primary btn-lg w-full">Request Consultation</button>
        </form>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-cream-50">
    <div class="container-site max-w-6xl mx-auto grid gap-10 lg:grid-cols-2 items-start">
      <div>
        <p class="eyebrow" style="letter-spacing: 0.3em;">Local Service Areas</p>
        <h2 class="font-display text-4xl md:text-5xl text-ink-800 leading-tight mb-6">Serving St. Petersburg and Pinellas County</h2>
        <p class="text-ink-500 leading-relaxed mb-8">Select your specific community below to check your eligibility for a complimentary in-home design consultation.</p>
        <ul class="grid sm:grid-cols-2 gap-y-3 gap-x-6">
          {AREAS.map((a) => (
            <li>
              <a href={`/areas/${a.slug}/`} class="inline-flex items-center gap-2 text-brand-600 hover:text-brand-800 transition font-medium">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                {a.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="aspect-[4/3] overflow-hidden rounded-sm shadow-soft">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d56271.82398378395!2d-82.70485474755367!3d27.771192729988576!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88c2e2c3a4e5b8bf%3A0xe50e91b2dabe2c34!2sSt.%20Petersburg%2C%20FL!5e0!3m2!1sen!2sus!4v1700000000000"
          width="100%" height="100%" style="border:0;" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
          title="Custom Fabric Creations service area map"></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-space]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('button[data-space]').forEach((b) => b.classList.remove('border-brand-500', 'bg-brand-50'));
      btn.classList.add('border-brand-500', 'bg-brand-50');
      const input = document.getElementById('space') as HTMLInputElement | null;
      if (input) input.value = btn.dataset.space ?? 'residential';
    });
  });
</script>
