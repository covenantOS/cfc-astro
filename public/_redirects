# Cloudflare Pages redirects — preserve legacy WP URL patterns at cutover.

# Canonical host: www.customfabriccreations.net.
# 301 the apex and the *.pages.dev preview URL to www so search engines
# consolidate ranking signals on a single canonical hostname. The `!` suffix
# forces these to evaluate even when a matching static asset exists.
https://customfabriccreations.net/*  https://www.customfabriccreations.net/:splat  301!
https://cfc-astro.pages.dev/*        https://www.customfabriccreations.net/:splat  301!

# Redirect legacy sitemap-index URL (from earlier @astrojs/sitemap setup) to
# the canonical flat sitemap generated by src/pages/sitemap.xml.ts.
/sitemap-index.xml /sitemap.xml 301
/sitemap-0.xml     /sitemap.xml 301

# Normalize non-trailing-slash URLs to trailing-slash (WordPress default)
/about       /about/    301
/brands      /brands/   301
/contact     /contact/  301
/gallery     /gallery/  301
/services    /services/ 301
/areas       /areas/    301

# WordPress author/feed artifacts that may have external backlinks
/author/*    /about/    301
/feed/       /          301
/comments/feed/  /      301
/wp-admin/*  /contact/  301
/wp-login.php /contact/ 301
