# Cloudflare Pages redirects — preserve legacy WP URL patterns at cutover.

# Canonical host: www.customfabriccreations.net.
# Apex (customfabriccreations.net) is 301-redirected to www by a Cloudflare
# Worker bound to the apex route — see Cloudflare dashboard > Workers & Pages
# > cfc-apex-to-www and zone routes. This file does not handle that redirect
# because Pages _redirects is path-scoped per host, not host-to-host.
#
# The cfc-astro.pages.dev preview URL serves the same content as www but every
# page emits <link rel="canonical" href="https://www.customfabriccreations.net/..."/>
# so Google consolidates ranking on www regardless of which host crawls.

# Redirect legacy sitemap-index URL (from earlier @astrojs/sitemap setup) to
# the canonical flat sitemap generated by src/pages/sitemap.xml.ts.
/sitemap-index.xml /sitemap.xml 301
/sitemap-0.xml     /sitemap.xml 301

# Normalize non-trailing-slash URLs to trailing-slash (WordPress default)
/about       /about/    301
/brands      /brands/   301
/contact     /contact/  301
/gallery     /gallery/  301
/services    /services/ 301
/areas       /areas/    301

# WordPress author/feed artifacts that may have external backlinks
/author/*    /about/    301
/feed/       /          301
/comments/feed/  /      301
/wp-admin/*  /contact/  301
/wp-login.php /contact/ 301

